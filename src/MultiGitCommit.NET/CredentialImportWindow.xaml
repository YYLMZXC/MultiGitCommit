<Window x:Class="MultiGitCommit.CredentialImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="检测到系统 git 凭据"
        Icon="res\icon.ico"
        Width="600" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        ShowInTaskbar="False">

    <StackPanel Margin="14">
        <TextBlock Text="以下账号来自系统已保存的 git 凭据（Windows 凭据管理器 / ~/.git-credentials / credential helper）。勾选要导入的账号，导入后可在上方列表中继续编辑："
                   TextWrapping="Wrap" Margin="0,0,0,8"/>

        <ListView x:Name="ListCred" Height="240">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="导入" Width="50">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="主机" Width="180" DisplayMemberBinding="{Binding Host}"/>
                    <GridViewColumn Header="用户名（账号）" Width="140" DisplayMemberBinding="{Binding Username}"/>
                    <GridViewColumn Header="来源" Width="190" DisplayMemberBinding="{Binding Source}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="全选" Width="80" Padding="8,2" Click="BtnSelectAll_Click"/>
            <Button Content="全不选" Width="80" Margin="8,0,0,0" Padding="8,2" Click="BtnSelectNone_Click"/>
            <TextBlock Text="令牌不会在此显示，导入后可在列表中选中查看/修改"
                       VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#888" FontSize="11"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="导入选中" Width="90" IsDefault="True" Padding="8,2" Click="BtnOk_Click"/>
            <Button Content="取消" Width="80" IsCancel="True" Margin="8,0,0,0" Padding="8,2"/>
        </StackPanel>
    </StackPanel>
</Window>
