<Window x:Class="MultiGitCommit.GitSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Git 环境设置"
        Icon="res\icon.ico"
        Width="620" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        ShowInTaskbar="False">

    <StackPanel Margin="14">
        <TextBlock Text="选择本工具执行 git 命令所用的 git.exe 来源（不依赖系统是否安装 / 配置 git）："
                   TextWrapping="Wrap" Margin="0,0,0,8"/>

        <RadioButton x:Name="RbAuto" Content="自动检测（推荐）：软件内嵌便携版 Git → 常见安装位置 → 系统 PATH"
                     Margin="0,3" Checked="Mode_Changed"/>
        <RadioButton x:Name="RbEmbedded" Content="仅使用软件内嵌的便携版 Git（软件目录 git\ 子目录，随软件分发）"
                     Margin="0,3" Checked="Mode_Changed"/>
        <RadioButton x:Name="RbSystem" Content="仅使用系统 PATH 环境变量中的 git（环境 git）"
                     Margin="0,3" Checked="Mode_Changed"/>
        <RadioButton x:Name="RbCustom" Content="指定 git.exe 或 Git 目录（软件自带 / 便携版 Git）"
                     Margin="0,3" Checked="Mode_Changed"/>

        <Grid Margin="20,4,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtCustomPath" Grid.Column="0" VerticalContentAlignment="Center"
                     ToolTip="git.exe 完整路径，或 Git 安装/解压根目录（自动查找其中的 cmd\git.exe、bin\git.exe）"/>
            <Button x:Name="BtnBrowse" Grid.Column="1" Content="浏览..." Margin="6,0,0,0"
                    Padding="10,2" Click="BtnBrowse_Click"
                    ToolTip="选择 git.exe 文件；若想指定 Git 根目录请直接粘贴目录路径"/>
        </Grid>

        <Button x:Name="BtnTest" Content="测试当前所选配置" HorizontalAlignment="Left"
                Padding="10,2" Margin="0,10,0,0" Click="BtnTest_Click"/>

        <TextBlock x:Name="TxtResult" TextWrapping="Wrap" Margin="0,8,0,0"
                   MinHeight="18" Foreground="#666"/>

        <TextBlock Text="推送凭据 / 账号（https 远端免交互推送用）"
                   Margin="0,14,0,4" FontWeight="Bold"/>
        <TextBlock Text="工具为非交互执行（禁用终端提示），https 远端没有账号时 git 无法弹窗询问，推送必然失败。可选择账号来源：自动检测（优先自定义，缺失时取系统）、仅系统、仅自定义、不使用。"
                   TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#666"/>

        <RadioButton x:Name="RbCredAuto" Content="自动检测（推荐）：优先使用已保存的账号，缺失时自动从系统凭据获取"
                     Margin="0,3" Checked="CredMode_Changed"/>
        <RadioButton x:Name="RbCredSystem" Content="仅使用系统凭据：每次推送实时向凭据管理器/helper 索取（令牌不保存到配置文件）"
                     Margin="0,3" Checked="CredMode_Changed"/>
        <RadioButton x:Name="RbCredCustom" Content="仅使用自定义账号：只用下方保存的凭据，不访问系统"
                     Margin="0,3" Checked="CredMode_Changed"/>
        <RadioButton x:Name="RbCredNone" Content="不使用凭据：ssh 远端，或已自行配置（ssh-agent / URL 内已带账号）"
                     Margin="0,3" Checked="CredMode_Changed"/>

        <TextBlock Text="自定义账号列表（按主机匹配，可配置多个；点【检测系统凭据】可把系统已保存的账号导入到这里）"
                   Margin="0,10,0,4"/>

        <ListBox x:Name="ListCred" Height="90" SelectionChanged="ListCred_SelectionChanged"/>

        <Grid Margin="0,6,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="主机（如 cnb.cool）" FontSize="11" Foreground="#666" Margin="0,0,0,2"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="用户名" FontSize="11" Foreground="#666" Margin="6,0,0,2"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="访问令牌 / 密码" FontSize="11" Foreground="#666" Margin="6,0,0,2"/>
            <TextBox x:Name="TxtCredHost" Grid.Row="1" Grid.Column="0" VerticalContentAlignment="Center"
                     ToolTip="远端主机名（cnb.cool / gitee.com / github.com），也可直接粘贴完整 URL"/>
            <TextBox x:Name="TxtCredUser" Grid.Row="1" Grid.Column="1" Margin="6,0,0,0" VerticalContentAlignment="Center"
                     ToolTip="平台账号名"/>
            <PasswordBox x:Name="TxtCredToken" Grid.Row="1" Grid.Column="2" Margin="6,0,0,0" VerticalContentAlignment="Center"
                         ToolTip="平台的访问令牌（Personal Access Token），比填登录密码更安全"/>
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Button x:Name="BtnCredAdd" Content="添加/更新" Padding="10,2" Click="BtnCredAdd_Click"/>
            <Button x:Name="BtnCredDelete" Content="删除" Padding="10,2" Margin="6,0,0,0" Click="BtnCredDelete_Click"/>
            <Button x:Name="BtnCredDetect" Content="检测系统凭据…" Padding="10,2" Margin="6,0,0,0" Click="BtnCredDetect_Click"
                    ToolTip="打开检测窗口：自行选择要检测的主机，再按需导入（可选择停止，不会全量扫描）"/>
            <TextBlock Text="凭据明文保存在 %APPDATA%\MultiGitCommit\settings.json"
                       VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#888" FontSize="11"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="确定" Width="80" IsDefault="True" Padding="8,2" Click="BtnOk_Click"/>
            <Button Content="取消" Width="80" IsCancel="True" Margin="8,0,0,0" Padding="8,2"/>
        </StackPanel>
    </StackPanel>
</Window>
