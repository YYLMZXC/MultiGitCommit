<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>MultiGitCommit</RootNamespace>
    <AssemblyName>MultiGitCommit</AssemblyName>
    <Platforms>AnyCPU;x64</Platforms>
    <Version>1.1.0</Version>
    <!-- 应用程序图标：嵌入到 .exe 资源中，作为文件图标与任务栏图标。 -->
    <ApplicationIcon>res\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- 文件夹选择对话框使用 System.Windows.Forms.FolderBrowserDialog；
       通过 <UseWindowsForms>true</UseWindowsForms> 引用 System.Windows.Forms 程序集（SDK 自动处理，无需显式 Reference）。
       但 SDK 会隐式全局引入 System.Windows.Forms / System.Drawing 命名空间，导致与 WPF 类型（Application/Button/TextBox 等）歧义，
       因此在此移除隐式 using，仅在 MainWindow.xaml.cs 中用别名显式引入 FolderBrowserDialog。 -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- 软件图标资源：ico 嵌入 WPF 资源供 Window.Icon 引用；png 复制到输出目录备用。 -->
  <ItemGroup>
    <Resource Include="res\icon.ico" />
    <None Include="res\icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- 内嵌便携版 Git（MinGit）：仓库根目录运行 download-portable-git.ps1 后，
       便携版位于 src\git\（cmd\git.exe、mingw64\ 等），构建时原样复制到输出目录 git\ 子目录。
       GitLocator 自动检测优先使用软件目录 git\cmd\git.exe，用户无需额外安装 git。
       文件夹不存在时此通配不匹配任何文件，不影响构建。 -->
  <ItemGroup>
    <None Include="git\**\*" Visible="false" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
