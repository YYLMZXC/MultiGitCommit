<Window x:Class="MultiGitCommit.CloneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="克隆项目"
        Icon="res\icon.ico"
        Width="640" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        ShowInTaskbar="False">

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 远端 URL -->
            <RowDefinition Height="Auto"/>   <!-- 克隆到（父目录） -->
            <RowDefinition Height="Auto"/>   <!-- 目录名 -->
            <RowDefinition Height="Auto"/>   <!-- 分支 -->
            <RowDefinition Height="Auto"/>   <!-- 选项 -->
            <RowDefinition Height="Auto"/>   <!-- 预览 -->
            <RowDefinition Height="Auto"/>   <!-- 按钮 -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="远端 URL：" VerticalAlignment="Center" Margin="0,0,6,8"/>
        <TextBox x:Name="TxtUrl" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" VerticalContentAlignment="Center"
                 Margin="0,0,0,8" TextChanged="TxtUrl_TextChanged"
                 ToolTip="支持 ssh / https / 本地路径，例如 git@gitee.com:user/repo.git、https://github.com/user/repo.git"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="克隆到：" VerticalAlignment="Center" Margin="0,0,6,8"/>
        <TextBox x:Name="TxtParentDir" Grid.Row="1" Grid.Column="1" VerticalContentAlignment="Center"
                 Margin="0,0,0,8" TextChanged="Input_Changed"
                 ToolTip="本地父目录，仓库将被克隆到该目录下的【目录名】子文件夹"/>
        <Button Grid.Row="1" Grid.Column="2" Content="浏览..." Margin="6,0,0,8" Padding="10,2"
                Click="BtnBrowseParent_Click" ToolTip="选择本地父目录"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="目录名：" VerticalAlignment="Center" Margin="0,0,6,8"/>
        <TextBox x:Name="TxtFolderName" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" VerticalContentAlignment="Center"
                 Margin="0,0,0,8" TextChanged="TxtFolderName_TextChanged"
                 ToolTip="目标文件夹名，默认根据远端 URL 自动推导，可手动修改"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="分支：" VerticalAlignment="Center" Margin="0,0,6,8"/>
        <TextBox x:Name="TxtBranch" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" VerticalContentAlignment="Center"
                 Margin="0,0,0,8" TextChanged="Input_Changed"
                 ToolTip="可选：指定要克隆并检出的分支（--branch）；留空则使用远端默认分支"/>

        <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8">
            <CheckBox x:Name="ChkRecursive" Content="递归克隆子模块 --recursive" Margin="0,2" Checked="Input_Changed" Unchecked="Input_Changed"/>
            <CheckBox x:Name="ChkShallow" Content="浅克隆 --depth 1（仅拉取最近一次提交，速度快）" Margin="0,2" Checked="Input_Changed" Unchecked="Input_Changed"/>
            <CheckBox x:Name="ChkAddRemote" Content="克隆后把该 URL 添加到本项目的推送远端列表" Margin="0,2"/>
        </StackPanel>

        <GroupBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Header="预览" Padding="6" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="目标路径：" Foreground="#666"/>
                <TextBlock x:Name="TxtTargetPath" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#2B579A"/>
                <TextBlock Text="将执行命令：" Foreground="#666"/>
                <TextBlock x:Name="TxtCommandPreview" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Foreground="#2B579A"/>
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="开始克隆" Width="90" IsDefault="True" Padding="8,2" Click="BtnOk_Click"/>
            <Button Content="取消" Width="80" IsCancel="True" Margin="8,0,0,0" Padding="8,2"/>
        </StackPanel>
    </Grid>
</Window>
