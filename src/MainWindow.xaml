<Window x:Class="MultiGitCommit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MultiGitCommit - 一键提交推送工具"
        Icon="res\icon.ico"
        Width="980" Height="760"
        MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI" FontSize="13">

    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,4,0,6"/>
            <Setter Property="Foreground" Value="#2B579A"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="4,2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 仓库目录 -->
            <RowDefinition Height="Auto"/>   <!-- 远端管理 -->
            <RowDefinition Height="Auto"/>   <!-- 提交设置 -->
            <RowDefinition Height="Auto"/>   <!-- 主按钮 -->
            <RowDefinition Height="Auto"/>   <!-- 手动命令 -->
            <RowDefinition Height="*"/>      <!-- 日志 -->
        </Grid.RowDefinitions>

        <!-- ============ 一、仓库目录区域 ============ -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="仓库目录：" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="TxtRepoPath" Grid.Column="1" VerticalContentAlignment="Center"
                     TextChanged="TxtRepoPath_TextChanged"
                     ToolTip="Git 仓库本地根目录路径，与 .git 文件夹同级"/>
            <Button x:Name="BtnBrowse" Grid.Column="2" Content="选择文件夹" Click="BtnBrowse_Click" Margin="6,2,4,2"/>
            <Button x:Name="BtnLoadConfig" Grid.Column="3" Content="重新加载配置" Click="BtnLoadConfig_Click" Margin="4,2,0,2"
                    ToolTip="重新读取当前目录下的 multigitcommit.config.json"/>
            <Button x:Name="BtnAbout" Grid.Column="4" Content="关于" Click="BtnAbout_Click" Margin="4,2,0,2"
                    ToolTip="关于 MultiGitCommit 及项目地址"/>
        </Grid>

        <!-- ============ 二、远端地址管理区域 ============ -->
        <GroupBox Grid.Row="1" Header="推送远端地址管理（每个项目独立保存到 multigitcommit.config.json）" Padding="6" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnAddRemote" Content="添加远端" Click="BtnAddRemote_Click"/>
                    <Button x:Name="BtnEditRemote" Content="编辑选中" IsEnabled="False" Click="BtnEditRemote_Click"/>
                    <Button x:Name="BtnDeleteRemote" Content="删除选中" IsEnabled="False" Click="BtnDeleteRemote_Click"/>
                    <Button x:Name="BtnOpenRemote" Content="在浏览器中打开" IsEnabled="False" Click="BtnOpenRemote_Click" ToolTip="使用系统默认浏览器打开选中的远端 URL"/>
                </StackPanel>
                <ListBox x:Name="ListRemotes" Grid.Row="1" Height="110" Margin="0,4,0,0"
                         SelectionChanged="ListRemotes_SelectionChanged"
                         ToolTip="当前项目保存的全部远端 URL（ssh/https 均支持）"/>
            </Grid>
        </GroupBox>

        <!-- ============ 三、提交相关输入控件 ============ -->
        <GroupBox Grid.Row="2" Header="提交设置" Padding="6" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="提交备注：" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="TxtCommitMessage" Grid.Column="1" VerticalContentAlignment="Center"
                             ToolTip="留空时 commit 消息仅使用本地时间，格式：yyyy-MM-dd HH:mm:ss 用户备注"/>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <CheckBox x:Name="ChkAddAll" Content="执行 git add . （默认不勾选，避免误提交垃圾文件）" Margin="0,2,20,2" VerticalAlignment="Center"
                              Checked="ChkAddAll_Changed" Unchecked="ChkAddAll_Changed"/>
                    <CheckBox x:Name="ChkPushTags" Content="推送标签 --tags（默认不勾选）" Margin="0,2,0,2" VerticalAlignment="Center"
                              Checked="ChkPushTags_Changed" Unchecked="ChkPushTags_Changed"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- ============ 四、主执行按钮 ============ -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BtnCommitPush" Content="执行提交并推送全部远端" Width="240" Height="38"
                    FontSize="15" FontWeight="Bold" Click="BtnCommitPush_Click"/>
            <TextBlock x:Name="TxtBranchInfo" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#666"/>
        </StackPanel>

        <!-- ============ 五、手动命令执行区 ============ -->
        <GroupBox Grid.Row="4" Header="手动命令执行区（在当前仓库目录执行任意 git/cmd 命令）" Padding="6" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtCommand" Grid.Column="0" VerticalContentAlignment="Center"
                         ToolTip="例如：git status / git log --oneline -5 / dir"
                         KeyDown="TxtCommand_KeyDown"/>
                <Button x:Name="BtnRunCommand" Grid.Column="1" Content="执行命令" Click="BtnRunCommand_Click" Margin="6,2,0,2"/>
            </Grid>
        </GroupBox>

        <!-- ============ 六、日志输出区 ============ -->
        <GroupBox Grid.Row="5" Header="日志输出" Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBox x:Name="TxtLog" Grid.Row="0"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="12"
                         Background="#1E1E1E" Foreground="#DCDCDC"
                         BorderBrush="#444"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0" HorizontalAlignment="Left">
                    <Button x:Name="BtnClearLog" Content="清空日志" Click="BtnClearLog_Click" Padding="10,2"/>
                    <CheckBox x:Name="ChkAutoScroll" Content="自动滚动到底部" IsChecked="True" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
