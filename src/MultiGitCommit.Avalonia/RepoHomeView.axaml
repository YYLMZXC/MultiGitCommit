<!-- 仓库管理首页：过往访问的项目记录 + 本地 Git 仓库自动发现，支持统一管理与快速跳转。
     以覆盖层形式嵌在 MainView 内（对话框覆盖层 Overlay 在其后声明，保证弹窗始终盖在本页之上）。 -->
<UserControl x:Class="MultiGitCommit.RepoHomeView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI,PingFang SC,Noto Sans CJK SC,Source Han Sans SC,DejaVu Sans" FontSize="13">

    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="4,2"/>
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#2B579A"/>
        </Style>
        <Style Selector="Button.linkBtn">
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </UserControl.Styles>

    <!-- 浅色背景（全应用锁定 Light 主题，见 App.axaml）：首页以覆盖层形式盖在项目页上方，
         必须不透明，否则项目页内容会从下方穿透显示 -->
    <Border Background="#F9F9F9">
        <Grid Margin="16,14,16,12" RowDefinitions="Auto,Auto,*,Auto">

            <!-- ============ 标题 ============ -->
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="{DynamicResource L.RepoHomeView.L031.Text}" FontSize="20" FontWeight="Bold"/>
                <TextBlock Foreground="#666" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="{DynamicResource L.RepoHomeView.L033.Text}"/>
            </StackPanel>

            <!-- ============ 一、最近打开的项目 ============ -->
            <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="sectionTitle" Text="{DynamicResource L.RepoHomeView.L040.Text}" VerticalAlignment="Center"
                                   ToolTip.Tip="{DynamicResource L.RepoHomeView.L041.ToolTip_Tip}"/>
                        <Button x:Name="BtnClearRecent" Grid.Column="1" Content="{DynamicResource L.RepoHomeView.L042.Content}" Click="BtnClearRecent_Click"
                                ToolTip.Tip="{DynamicResource L.RepoHomeView.L043.ToolTip_Tip}"/>
                    </Grid>
                    <TextBlock x:Name="TxtRecentEmpty" Foreground="#999" Margin="0,6,0,0"
                               Text="{DynamicResource L.RepoHomeView.L046.Text}"/>
                    <!-- 最近项目最多 10 条，窄屏路径换行后每项很高：限高并内部滚动，
                         避免把下面的自动发现列表与底部操作条挤出视口 -->
                    <ScrollViewer x:Name="RecentScroll" Margin="0,4,0,0" MaxHeight="200"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ListRecent">
                            <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="0,4">
                                    <!-- 两个列表共用同一套「路径 / 分支」标签资源键：语义键不随 XAML 行号漂移 -->
                                    <Grid RowDefinitions="Auto,Auto">
                                        <StackPanel Grid.Row="0" VerticalAlignment="Center" Margin="0,0,6,0">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <TextBlock Grid.Column="0" Foreground="#666" VerticalAlignment="Top" Margin="0,0,4,0"
                                                           Text="{DynamicResource L.RepoHomeView.NameLabel.Text}"/>
                                                <TextBlock Grid.Column="1" FontWeight="SemiBold" Foreground="#222" Text="{Binding Name}" TextWrapping="Wrap"
                                                           ToolTip.Tip="{DynamicResource L.RepoHomeView.NameLabel.ToolTip_Tip}"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,0">
                                                <TextBlock Grid.Column="0" Foreground="#666" VerticalAlignment="Top" Margin="0,0,4,0"
                                                           Text="{DynamicResource L.RepoHomeView.PathLabel.Text}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding RepoPath}" TextWrapping="Wrap" ToolTip.Tip="{Binding RepoPath}"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,0">
                                                <TextBlock Grid.Column="0" Foreground="#666" VerticalAlignment="Top" Margin="0,0,4,0"
                                                           Text="{DynamicResource L.RepoHomeView.BranchLabel.Text}"/>
                                                <TextBlock Grid.Column="1" Foreground="#2B579A" Text="{Binding Branch}" TextWrapping="Wrap"
                                                           ToolTip.Tip="{DynamicResource L.RepoHomeView.BranchLabel.ToolTip_Tip}"/>
                                            </Grid>
                                        </StackPanel>
                                    <!-- 窄屏按钮单独一行并自动换行，不挤压路径文本 -->
                                    <WrapPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Classes="linkBtn" Content="{DynamicResource L.RepoHomeView.L053.Content}" Click="OpenRepo_Click"
                                                ToolTip.Tip="{DynamicResource L.RepoHomeView.L054.ToolTip_Tip}"/>
                                        <Button Classes="linkBtn" Content="{DynamicResource L.RepoHomeView.OpenFolder.Content}" Click="OpenFolder_Click"
                                                ToolTip.Tip="{DynamicResource L.RepoHomeView.OpenFolder.ToolTip_Tip}"/>
                                        <Button Classes="linkBtn" Content="{DynamicResource L.RepoHomeView.L055.Content}" Click="RemoveRecent_Click"
                                                ToolTip.Tip="{DynamicResource L.RepoHomeView.L056.ToolTip_Tip}"/>
                                    </WrapPanel>
                                </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- ============ 二、本地 Git 仓库（自动发现） ============ -->
            <Border Grid.Row="2" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Padding="10">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <TextBlock Classes="sectionTitle" Text="{DynamicResource L.RepoHomeView.L069.Text}" VerticalAlignment="Center"
                                   ToolTip.Tip="{DynamicResource L.RepoHomeView.L070.ToolTip_Tip}"/>
                        <Button x:Name="BtnRescan" Grid.Column="1" Content="{DynamicResource L.RepoHomeView.L071.Content}" Click="BtnRescan_Click"
                                ToolTip.Tip="{DynamicResource L.RepoHomeView.L072.ToolTip_Tip}"/>
                    </Grid>
                    <TextBlock x:Name="TxtScanStatus" Grid.Row="1" Foreground="#666" TextWrapping="Wrap" Margin="0,6,0,4"/>
                    <ScrollViewer x:Name="DiscoveredScroll" Grid.Row="2" MinHeight="120" MaxHeight="320"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ListDiscovered">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="0,4">
                                        <Grid RowDefinitions="Auto,Auto">
                                            <StackPanel Grid.Row="0" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <TextBlock Grid.Column="0" Foreground="#666" VerticalAlignment="Top" Margin="0,0,4,0"
                                                               Text="{DynamicResource L.RepoHomeView.NameLabel.Text}"/>
                                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Foreground="#222" Text="{Binding Name}" TextWrapping="Wrap"
                                                               ToolTip.Tip="{DynamicResource L.RepoHomeView.NameLabel.ToolTip_Tip}"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,0">
                                                    <TextBlock Grid.Column="0" Foreground="#666" VerticalAlignment="Top" Margin="0,0,4,0"
                                                               Text="{DynamicResource L.RepoHomeView.PathLabel.Text}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding RepoPath}" TextWrapping="Wrap" ToolTip.Tip="{Binding RepoPath}"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,0">
                                                    <TextBlock Grid.Column="0" Foreground="#666" VerticalAlignment="Top" Margin="0,0,4,0"
                                                               Text="{DynamicResource L.RepoHomeView.BranchLabel.Text}"/>
                                                    <TextBlock Grid.Column="1" Foreground="#2B579A" Text="{Binding Branch}" TextWrapping="Wrap"
                                                               ToolTip.Tip="{DynamicResource L.RepoHomeView.BranchLabel.ToolTip_Tip}"/>
                                                </Grid>
                                            </StackPanel>
                                            <!-- 窄屏按钮单独一行并自动换行，不挤压路径文本 -->
                                            <WrapPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Classes="linkBtn" Content="{DynamicResource L.RepoHomeView.L053.Content}" Click="OpenRepo_Click"
                                                        ToolTip.Tip="{DynamicResource L.RepoHomeView.L054.ToolTip_Tip}"/>
                                                <Button Classes="linkBtn" Content="{DynamicResource L.RepoHomeView.OpenFolder.Content}" Click="OpenFolder_Click"
                                                        ToolTip.Tip="{DynamicResource L.RepoHomeView.OpenFolder.ToolTip_Tip}"/>
                                            </WrapPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="TxtDiscoveredEmpty" Grid.Row="2" Foreground="#999" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="{DynamicResource L.RepoHomeView.L091.Text}"/>
                </Grid>
            </Border>

            <!-- ============ 三、底部操作条 ============ -->
            <!-- 底部操作条：窄屏自动换行，避免「默认启动页」单选按钮被横向裁掉 -->
            <WrapPanel Grid.Row="3" Margin="0,10,0,0" Orientation="Horizontal">
                <Button x:Name="BtnPickFolder" Content="{DynamicResource L.RepoHomeView.L097.Content}" Click="BtnPickFolder_Click" Height="34"
                        ToolTip.Tip="{DynamicResource L.RepoHomeView.L098.ToolTip_Tip}"/>
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="{DynamicResource L.RepoHomeView.L100.Text}" VerticalAlignment="Center"
                               ToolTip.Tip="{DynamicResource L.RepoHomeView.L101.ToolTip_Tip}"/>
                    <RadioButton x:Name="RadioStartRepoPage" GroupName="StartPage" Content="{DynamicResource L.RepoHomeView.L102.Content}" VerticalAlignment="Center"
                                 Margin="6,0,0,0" IsCheckedChanged="StartPage_Changed"
                                 ToolTip.Tip="{DynamicResource L.RepoHomeView.L104.ToolTip_Tip}"/>
                    <RadioButton x:Name="RadioStartHome" GroupName="StartPage" Content="{DynamicResource L.RepoHomeView.L105.Content}" VerticalAlignment="Center"
                                 Margin="4,0,0,0" IsCheckedChanged="StartPage_Changed"
                                 ToolTip.Tip="{DynamicResource L.RepoHomeView.L107.ToolTip_Tip}"/>
                </WrapPanel>
            </WrapPanel>
        </Grid>
    </Border>
</UserControl>
