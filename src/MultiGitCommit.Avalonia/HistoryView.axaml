<UserControl x:Class="MultiGitCommit.HistoryView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="920" MinHeight="540"
             FontFamily="Microsoft YaHei UI,PingFang SC,Noto Sans CJK SC,Source Han Sans SC,DejaVu Sans" FontSize="13">

    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="4,2"/>
        </Style>
        <!-- 历史列表行更紧凑：默认行高会把 200 条记录撑得很散 -->
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
    </UserControl.Styles>

    <!-- 底部操作栏固定可见，其余内容整体放进 ScrollViewer：
         手机上不再用「两个 Bottom 区块 + 中间列表」把视口挤爆，长单选文案也会换行。
         表头与列表行改用比例列 + 最小宽度，宽屏铺满、窄屏自动收敛，不再固定 130/80/120 导致右侧裁切。 -->
    <DockPanel Margin="12">

        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0" ColumnDefinitions="*,Auto">
            <TextBlock x:Name="TxtProgress" Grid.Column="0" TextWrapping="Wrap"
                       VerticalAlignment="Center" Foreground="#2B579A"/>
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                <Button x:Name="BtnReset" Content="重置到选中提交" Click="BtnReset_Click" IsEnabled="False"
                        ToolTip.Tip="执行 git reset，把当前分支回退到选中提交（执行前会二次确认）"/>
                <Button Content="关闭" Width="80" IsCancel="True" Click="BtnClose_Click"/>
            </WrapPanel>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="提交历史（当前分支，最新在前）" FontWeight="Bold" FontSize="14" Foreground="#2B579A"/>

                <Grid Margin="0,6,0,0" ColumnDefinitions="*,Auto">
                    <TextBox x:Name="TxtRepoPath" Grid.Column="0" IsReadOnly="True" VerticalContentAlignment="Center"/>
                    <Button x:Name="BtnRefresh" Grid.Column="1" Content="刷新" Click="BtnRefresh_Click" Margin="6,2,0,2"/>
                </Grid>

                <TextBlock x:Name="TxtStatus" TextWrapping="Wrap" Margin="0,6,0,6" Foreground="#666"/>

                <Grid Margin="6,0,18,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*" MinWidth="80"/>
                        <ColumnDefinition Width="0.8*" MinWidth="48"/>
                        <ColumnDefinition Width="1.2*" MinWidth="56"/>
                        <ColumnDefinition Width="2*" MinWidth="72"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="时间" Foreground="#666" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="提交" Foreground="#666" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="2" Text="作者" Foreground="#666" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="3" Text="说明" Foreground="#666" TextTrimming="CharacterEllipsis"/>
                </Grid>

                <!-- 固定高度：列表自身滚动，外层 ScrollViewer 只需滚过表头 / 文件区 / 重置选项 -->
                <ListBox x:Name="ListCommits" Height="240" SelectionChanged="ListCommits_SelectionChanged"
                         BorderBrush="#CCCCCC" BorderThickness="1" Padding="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.3*" MinWidth="80"/>
                                    <ColumnDefinition Width="0.8*" MinWidth="48"/>
                                    <ColumnDefinition Width="1.2*" MinWidth="56"/>
                                    <ColumnDefinition Width="2*" MinWidth="72"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Date}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding ShortHash}" VerticalAlignment="Center"
                                           FontFamily="Consolas,Menlo,DejaVu Sans Mono,Noto Sans Mono"
                                           Foreground="#2B579A" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="{Binding Author}" VerticalAlignment="Center"
                                           Foreground="#555" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="3" Text="{Binding Subject}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 修改文件区：选中提交后显示该提交改动的文件清单 -->
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Margin="0,8,0,0">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,4" ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="TxtFilesTitle" Grid.Column="0" Text="修改的文件（选中提交后显示）"
                                       FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                                <Button x:Name="BtnOpenFile" Content="打开选中文件" Click="BtnOpenFile_Click" IsEnabled="False"
                                        ToolTip.Tip="用系统默认程序（按文件类型关联）打开选中文件，也可直接双击列表项或按回车"/>
                                <Button x:Name="BtnRevealFile" Content="打开所在文件夹" Click="BtnRevealFile_Click" IsEnabled="False"
                                        ToolTip.Tip="在文件管理器中定位（Windows 资源管理器 / macOS Finder / Linux 文件管理器）；已删除的文件也能打开其所在目录"/>
                            </WrapPanel>
                        </Grid>
                        <ListBox x:Name="ListFiles" Grid.Row="1" Height="130" Padding="0"
                                 BorderBrush="#DDDDDD" BorderThickness="1"
                                 SelectionChanged="ListFiles_SelectionChanged"
                                 DoubleTapped="ListFiles_DoubleTapped"
                                 KeyDown="ListFiles_KeyDown"
                                 ToolTip.Tip="双击（或选中后按回车）用系统默认程序打开对应文件；上方按钮可在文件管理器中定位">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding StatusLabel}" FontWeight="Bold"
                                                   FontFamily="Consolas,Menlo,DejaVu Sans Mono,Noto Sans Mono" Foreground="#2B579A"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Display}" TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding Path}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- 重置模式与提示 -->
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Margin="0,8,0,0">
                    <StackPanel Margin="10">
                        <TextBlock Text="重置到选中提交（只影响本地分支，不会推送远端）" FontWeight="SemiBold" TextWrapping="Wrap"/>

                        <RadioButton x:Name="RbSoft" Margin="0,3" IsChecked="True">
                            <TextBlock Text="soft：只移动 HEAD，改动保留在暂存区（最安全，推荐）" TextWrapping="Wrap"/>
                        </RadioButton>
                        <RadioButton x:Name="RbMixed" Margin="0,3">
                            <TextBlock Text="mixed：重置暂存区，工作区文件内容不变（git reset 默认行为）" TextWrapping="Wrap"/>
                        </RadioButton>
                        <RadioButton x:Name="RbHard" Margin="0,3">
                            <TextBlock Text="hard：丢弃工作区所有未提交改动（不可恢复，请谨慎）"
                                       Foreground="#C00000" TextWrapping="Wrap"/>
                        </RadioButton>

                        <TextBlock x:Name="TxtHint" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#666"
                                   Text="请先在列表中选择要重置到的提交。"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
