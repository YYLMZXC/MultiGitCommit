<UserControl x:Class="MultiGitCommit.IdentityView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="540"
             FontFamily="Microsoft YaHei UI,PingFang SC,Noto Sans CJK SC,Source Han Sans SC,DejaVu Sans" FontSize="13">

    <!-- 底部按钮固定，说明文字 / 单选放进 ScrollViewer：移动端窄屏下可滚动查看，按钮常驻可见。 -->
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{DynamicResource L.IdentityView.L011.Content}" Width="90" IsDefault="True" Padding="8,2" Click="BtnOk_Click"/>
            <Button Content="{DynamicResource L.IdentityView.L012.Content}" Width="80" IsCancel="True" Margin="8,0,0,0" Padding="8,2" Click="BtnCancel_Click"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="{DynamicResource L.IdentityView.L017.Text}"
                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,8" ColumnDefinitions="80,*" RowDefinitions="Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource L.IdentityView.L021.Text}" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtName" Grid.Row="0" Grid.Column="1" VerticalContentAlignment="Center" Margin="6,3"
                             ToolTip.Tip="{DynamicResource L.IdentityView.L023.ToolTip_Tip}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource L.IdentityView.L025.Text}" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtEmail" Grid.Row="1" Grid.Column="1" VerticalContentAlignment="Center" Margin="6,3"
                             ToolTip.Tip="{DynamicResource L.IdentityView.L027.ToolTip_Tip}"/>
                </Grid>

                <TextBlock Text="{DynamicResource L.IdentityView.L030.Text}" FontWeight="SemiBold" Margin="0,4,0,2"/>
                <StackPanel>
                    <RadioButton x:Name="RbLocal" Margin="0,3" IsChecked="True">
                        <TextBlock Text="{DynamicResource L.IdentityView.L033.Text}" TextWrapping="Wrap"/>
                    </RadioButton>
                    <RadioButton x:Name="RbGlobal" Margin="0,3">
                        <TextBlock Text="{DynamicResource L.IdentityView.L036.Text}" TextWrapping="Wrap"/>
                    </RadioButton>
                </StackPanel>

                <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#666" FontSize="11"
                           Text="{DynamicResource L.IdentityView.L041.Text}"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
