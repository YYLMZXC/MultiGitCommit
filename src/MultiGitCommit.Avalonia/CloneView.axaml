<UserControl x:Class="MultiGitCommit.CloneView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="680"
             FontFamily="Microsoft YaHei UI,PingFang SC,Noto Sans CJK SC,Source Han Sans SC,DejaVu Sans" FontSize="13">

    <!-- 底部按钮栏固定在 DockPanel 外侧，表单放进 ScrollViewer（横向禁用）：
         移动端覆盖层把宽度约束到视口后，长文案会换行、表单可纵向滚动且按钮始终可见。 -->
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{DynamicResource L.CloneView.L012.Content}" Width="90" IsDefault="True" Padding="8,2" Click="BtnOk_Click"/>
            <Button Content="{DynamicResource L.CloneView.L013.Content}" Width="80" IsCancel="True" Margin="8,0,0,0" Padding="8,2" Click="BtnCancel_Click"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- 远端 URL -->
                    <RowDefinition Height="Auto"/>   <!-- 克隆到（父目录） -->
                    <RowDefinition Height="Auto"/>   <!-- 目录名 -->
                    <RowDefinition Height="Auto"/>   <!-- 分支 -->
                    <RowDefinition Height="Auto"/>   <!-- 选项 -->
                    <RowDefinition Height="Auto"/>   <!-- 预览 -->
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource L.CloneView.L032.Text}" VerticalAlignment="Center" Margin="0,0,6,8"/>
                <TextBox x:Name="TxtUrl" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" VerticalContentAlignment="Center"
                         Margin="0,0,0,8" TextChanged="TxtUrl_TextChanged"
                         ToolTip.Tip="{DynamicResource L.CloneView.L035.ToolTip_Tip}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource L.CloneView.L037.Text}" VerticalAlignment="Center" Margin="0,0,6,8"/>
                <TextBox x:Name="TxtParentDir" Grid.Row="1" Grid.Column="1" VerticalContentAlignment="Center"
                         Margin="0,0,0,8" TextChanged="Input_Changed"
                         ToolTip.Tip="{DynamicResource L.CloneView.L040.ToolTip_Tip}"/>
                <Button x:Name="BtnBrowseParent" Grid.Row="1" Grid.Column="2" Content="{DynamicResource L.CloneView.L041.Content}" Margin="6,0,0,8" Padding="10,2"
                        Click="BtnBrowseParent_Click" ToolTip.Tip="{DynamicResource L.CloneView.L042.ToolTip_Tip}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource L.CloneView.L044.Text}" VerticalAlignment="Center" Margin="0,0,6,8"/>
                <TextBox x:Name="TxtFolderName" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" VerticalContentAlignment="Center"
                         Margin="0,0,0,8" TextChanged="TxtFolderName_TextChanged"
                         ToolTip.Tip="{DynamicResource L.CloneView.L047.ToolTip_Tip}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource L.CloneView.L049.Text}" VerticalAlignment="Center" Margin="0,0,6,8"/>
                <TextBox x:Name="TxtBranch" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" VerticalContentAlignment="Center"
                         Margin="0,0,0,8" TextChanged="Input_Changed"
                         ToolTip.Tip="{DynamicResource L.CloneView.L052.ToolTip_Tip}"/>

                <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8">
                    <CheckBox x:Name="ChkRecursive" Margin="0,2" IsCheckedChanged="Input_Changed">
                        <TextBlock Text="{DynamicResource L.CloneView.L056.Text}" TextWrapping="Wrap"/>
                    </CheckBox>
                    <CheckBox x:Name="ChkShallow" Margin="0,2" IsCheckedChanged="Input_Changed">
                        <TextBlock Text="{DynamicResource L.CloneView.L059.Text}" TextWrapping="Wrap"/>
                    </CheckBox>
                    <CheckBox x:Name="ChkAddRemote" Margin="0,2">
                        <TextBlock Text="{DynamicResource L.CloneView.L062.Text}" TextWrapping="Wrap"/>
                    </CheckBox>
                </StackPanel>

                <Border Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" BorderBrush="#CCCCCC" BorderThickness="1"
                        CornerRadius="4" Margin="0,0,0,10">
                    <StackPanel Margin="8">
                        <TextBlock Text="{DynamicResource L.CloneView.L069.Text}" Foreground="#666"/>
                        <TextBlock x:Name="TxtTargetPath" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#2B579A"/>
                        <TextBlock Text="{DynamicResource L.CloneView.L071.Text}" Foreground="#666"/>
                        <TextBlock x:Name="TxtCommandPreview" TextWrapping="Wrap" FontFamily="Consolas,Menlo,DejaVu Sans Mono,Noto Sans Mono" FontSize="12" Foreground="#2B579A"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
