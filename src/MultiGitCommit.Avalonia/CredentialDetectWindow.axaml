<Window x:Class="MultiGitCommit.CredentialDetectWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="检测系统 git 凭据"
        Width="680" Height="620"
        MinWidth="600" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI,PingFang SC" FontSize="13"
        ShowInTaskbar="False">

    <DockPanel>

        <!-- 底部按钮栏固定可见 -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="14,8,14,14">
            <Button Content="导入选中" Width="100" IsDefault="True" Padding="8,2" Click="BtnOk_Click"/>
            <Button Content="关闭" Width="80" IsCancel="True" Margin="8,0,0,0" Padding="8,2"/>
        </StackPanel>

        <!-- 中间内容区可滚动 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="14,14,14,6">
            <StackPanel>
                <TextBlock Text="从本机已保存的 git 凭据里检测账号（Windows 凭据管理器 / macOS 钥匙串 / ~/.git-credentials / credential helper）。为避免逐个扫描耗时，默认只勾选有明确线索的主机，其余按需自行勾选。"
                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                <!-- ============ 一、选择要检测的主机 ============ -->
                <TextBlock Text="1. 选择要检测的主机" FontWeight="SemiBold" Foreground="#2B579A" Margin="0,0,0,4"/>
                <Border BorderBrush="#DDD" BorderThickness="1" Padding="6" Margin="0,0,0,8">
                    <StackPanel>
                        <ListBox x:Name="ListHosts" Height="130">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="40,220,*">
                                        <CheckBox Grid.Column="0" IsChecked="{Binding Selected, Mode=TwoWay}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Host}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Origin}" VerticalAlignment="Center"
                                                   Foreground="#666" FontSize="11"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBox x:Name="TxtHost" Width="200" VerticalContentAlignment="Center"
                                     Watermark="主机，如 gitee.com"
                                     ToolTip.Tip="手动添加要检测的主机，例如 gitee.com"/>
                            <Button Content="添加主机" Padding="10,2" Margin="6,0,0,0" Click="BtnAddHost_Click"/>
                            <Button Content="全选" Width="70" Padding="8,2" Margin="12,0,0,0" Click="BtnSelectAll_Click"/>
                            <Button Content="全不选" Width="70" Padding="8,2" Margin="6,0,0,0" Click="BtnSelectNone_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============ 二、执行检测 ============ -->
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <Button x:Name="BtnDetect" Content="开始检测" Width="100" Padding="8,2" Click="BtnDetect_Click"/>
                    <Button x:Name="BtnStop" Content="停止" Width="80" Padding="8,2" Margin="8,0,0,0"
                            IsEnabled="False" Click="BtnStop_Click"/>
                    <TextBlock x:Name="TxtProgress" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#666"/>
                </StackPanel>
                <ProgressBar x:Name="Progress" Height="6" Margin="0,6,0,8" Minimum="0" Maximum="1" Value="0"/>

                <!-- ============ 三、检测结果与导入 ============ -->
                <TextBlock Text="2. 检测到的账号（勾选后导入）" FontWeight="SemiBold" Foreground="#2B579A" Margin="0,2,0,4"/>
                <Border BorderBrush="#DDD" BorderThickness="1" Padding="6" Margin="0,0,0,6">
                    <ListBox x:Name="ListResult" Height="140">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="40,200,160,*">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding Selected, Mode=TwoWay}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Host}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Username}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Source}" VerticalAlignment="Center"
                                               Foreground="#666" FontSize="11"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <TextBlock x:Name="TxtStatus" TextWrapping="Wrap" Foreground="#666" MinHeight="18"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
