<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 跨平台统一项目：一套代码同时支持 Windows 与 macOS（不依赖 WPF / WinForms） -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MultiGitCommit</RootNamespace>
    <AssemblyName>MultiGitCommit</AssemblyName>
    <!-- 版本号自动生成：yy.MM.dd-HHmm（构建机本地时间），无需手改。
         需要固定版本时用命令行覆盖：dotnet build -p:Version=26.11.03-1119 -->
    <BuildDate>$([System.DateTime]::Now.ToString('yy.MM.dd'))</BuildDate>
    <BuildTime>$([System.DateTime]::Now.ToString('HHmm'))</BuildTime>
    <Version Condition="'$(Version)' == ''">$(BuildDate)-$(BuildTime)</Version>
    <!-- 文件属性里的产品版本只保留版本号本身，不追加 git 提交哈希 -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- 发布目标平台：dotnet publish -r win-x64 / osx-arm64 / osx-x64 -->
    <RuntimeIdentifiers>win-x64;osx-arm64;osx-x64</RuntimeIdentifiers>
    <!-- 发布为 macOS 应用包（.app）时使用的元数据（Windows 下这些属性被忽略） -->
    <CFBundleName>MultiGitCommit</CFBundleName>
    <CFBundleDisplayName>MultiGitCommit</CFBundleDisplayName>
    <CFBundleIdentifier>com.yylmzxc.multigitcommit</CFBundleIdentifier>
    <!-- macOS：CFBundleShortVersionString 只接受纯数字三段，构建时刻放到 CFBundleVersion（与 Version 同源） -->
    <CFBundleShortVersionString Condition="'$(CFBundleShortVersionString)' == ''">$(BuildDate)</CFBundleShortVersionString>
    <CFBundleVersion Condition="'$(CFBundleVersion)' == ''">$(BuildTime)</CFBundleVersion>
    <NSHighResolutionCapable>true</NSHighResolutionCapable>
    <!-- AVLN3001：Avalonia 提示"窗口没有 public 无参构造函数，XAML 不能被运行时加载器访问"。
         本项目的窗口都通过带参构造函数创建（如 GitSettingsWindow(settings)），设计时加载器用不到，
         属预期行为，故静默该提示以保持生成日志干净。 -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>

  <!-- Windows：exe 文件图标（资源管理器 / 任务栏显示），必须是 .ico；
       macOS 应用包图标不走这里（需 .icns，打包时再配），因此限定只在 Windows 构建时生效。 -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <ApplicationIcon>res\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Release 发布为【单文件 exe（依赖框架）】：Avalonia、Skia 等依赖全部打进 MultiGitCommit.exe，
       输出目录只有 MultiGitCommit.exe + git 目录（不含 .NET 运行时，目标机器需已安装 .NET 10 运行时）。
       默认 RID 为 win-x64；发布其他平台时用 -r 覆盖：
         dotnet publish -c Release -r osx-arm64   （Apple 芯片 Mac）
         dotnet publish -c Release -r osx-x64     （Intel Mac）
       说明：单文件捆绑包的压缩只在独立模式（SelfContained）下支持，依赖框架模式不启用，故不设置。
       Debug 模式保持普通多文件输出，便于调试。 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- 默认 RID 按构建主机决定：Windows 用 win-x64，macOS（Rider / dotnet build -c Release）用 osx-arm64，
         避免在 Mac 上默认产出 Windows 版 exe；需要其他平台时仍可用 -r 覆盖。 -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">osx-arm64</RuntimeIdentifier>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- Avalonia 11 跨平台 UI（Windows 与 macOS 共用同一套 AXAML） -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.11" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.11" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.11" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.11" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.2" />
  </ItemGroup>

  <!-- 应用图标：以 Avalonia 资源嵌入，供 Window.Icon / App 图标使用（两平台共用 png） -->
  <ItemGroup>
    <AvaloniaResource Include="res\icon.png" />
  </ItemGroup>

  <!-- 内嵌便携版 Git（随软件分发，开箱即用）：
       Windows：把 git 发行包放在 src/MultiGitCommit.Avalonia/git/（cmd\git.exe、mingw64\ 等）；
       macOS   ：放在 git/bin/git。
       构建时原样复制到输出目录 git\ 子目录，GitLocator 的 Embedded / Auto 模式会自动优先使用。
       目录不存在时此通配不匹配任何文件，不影响构建。 -->
  <ItemGroup>
    <!-- ExcludeFromSingleFile：git 是数据目录，不能被打进 exe，必须保持为 exe 同级的 git\ 文件夹 -->
    <None Include="git\**\*" Visible="false" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
