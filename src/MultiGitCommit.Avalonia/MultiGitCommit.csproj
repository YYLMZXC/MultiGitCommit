<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="RuntimeIdentifier">

  <PropertyGroup>
    <!-- 跨平台统一项目：一套代码同时支持 Windows / macOS / Linux（桌面）与 Android / iOS（移动）。
         桌面走经典窗口生命周期（MainWindow 壳 + MainView）；
         移动走单视图生命周期（Platforms/Android/MainActivity、Platforms/iOS/AppDelegate + MainView）。 -->
    <TargetFrameworks>net10.0;net10.0-android;net10.0-ios</TargetFrameworks>
    <OutputType Condition="'$(TargetFramework)' == 'net10.0'">WinExe</OutputType>
    <OutputType Condition="'$(TargetFramework)' != 'net10.0'">Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MultiGitCommit</RootNamespace>
    <AssemblyName>MultiGitCommit</AssemblyName>
    <!-- 版本号自动生成：yy.MM.dd（构建机本地时间；构建时刻见 InformationalVersion），无需手改。
         需要固定版本时用命令行覆盖：dotnet build -p:Version=26.11.03 -->
    <BuildDate>$([System.DateTime]::Now.ToString('yy.MM.dd'))</BuildDate>
    <BuildTime>$([System.DateTime]::Now.ToString('dHHmm'))</BuildTime>
    <!-- ⚠ Version 必须是【纯数字日期】且各 TFM 完全一致：Android/iOS SDK 里有一条「ApplicationDisplayVersion 能解析成 System.Version 时就用它覆盖 Version」的规则；
         桌面侧若带 -dHHmm 后缀则各 TFM 的 PackageVersion 不同，NuGet 报 NU1105「PackageVersion 应在所有目标框架中具有单个值」，还原直接失败（VS 必现，命令行 NuGet 版本较宽容所以能过）。
         构建时刻改放 InformationalVersion（文件属性「产品版本」，AppVersion 标题仍只取日期部分）。 -->
    <Version Condition="'$(Version)' == ''">$(BuildDate)</Version>
    <InformationalVersion>$(BuildDate)-$(BuildTime)</InformationalVersion>
    <!-- 文件属性里的产品版本只保留版本号本身，不追加 git 提交哈希 -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- COM 互操作仅桌面需要（移动端不支持该属性） -->
    <BuiltInComInteropSupport Condition="'$(TargetFramework)' == 'net10.0'">true</BuiltInComInteropSupport>
    <!-- 发布目标平台：桌面 dotnet publish -r win-x64 / osx-arm64 / osx-x64 / linux-x64 / linux-arm64；
         移动端 dotnet publish -f net10.0-android -r android-arm64 / dotnet publish -f net10.0-ios -r ios-arm64。
         RuntimeIdentifiers 必须按 TFM 分别指定：桌面 RID 泄漏进移动端会触发 XA0035 / NETSDK1206。 -->
    <RuntimeIdentifiers Condition="'$(TargetFramework)' == 'net10.0'">win-x64;osx-arm64;osx-x64;linux-x64;linux-arm64</RuntimeIdentifiers>
    <RuntimeIdentifiers Condition="'$(TargetFramework)' == 'net10.0-android'">android-arm64;android-x64</RuntimeIdentifiers>
    <RuntimeIdentifiers Condition="'$(TargetFramework)' == 'net10.0-ios'">ios-arm64</RuntimeIdentifiers>
    <!-- 移动端应用标识：Android 包名 / iOS Bundle Identifier（与桌面 macOS 包一致） -->
    <ApplicationId>com.yylmzxc.multigitcommit</ApplicationId>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <ApplicationVersion>$(BuildTime)</ApplicationVersion>
    <!-- Android：.NET 10 下 minSdk 必须 ≥ 23（XA4216） -->
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-android'">23</SupportedOSPlatformVersion>
    <AndroidPackageFormat Condition="'$(TargetFramework)' == 'net10.0-android'">apk</AndroidPackageFormat>
    <AndroidEnableMultiDex Condition="'$(TargetFramework)' == 'net10.0-android'">true</AndroidEnableMultiDex>
    <!-- Android：原生库压缩存储 + 安装时解压。
         内嵌 git 的 ELF 段对齐为标准 4KB，若 extractNativeLibs=false（未压缩直存），
         在 16KB 页设备上安装会因 .so 未按 16KB 对齐被拒；压缩存储无此校验。 -->
    <AndroidExtractNativeLibs Condition="'$(TargetFramework)' == 'net10.0-android'">true</AndroidExtractNativeLibs>
    <!-- 发布为 macOS 应用包（.app）时使用的元数据（Windows 下这些属性被忽略） -->
    <CFBundleName Condition="'$(TargetFramework)' == 'net10.0'">MultiGitCommit</CFBundleName>
    <CFBundleDisplayName Condition="'$(TargetFramework)' == 'net10.0'">MultiGitCommit</CFBundleDisplayName>
    <CFBundleIdentifier Condition="'$(TargetFramework)' == 'net10.0'">com.yylmzxc.multigitcommit</CFBundleIdentifier>
    <!-- macOS：CFBundleShortVersionString 只接受纯数字三段，构建时刻放到 CFBundleVersion（与 Version 同源） -->
    <CFBundleShortVersionString Condition="'$(TargetFramework)' == 'net10.0' and '$(CFBundleShortVersionString)' == ''">$(BuildDate)</CFBundleShortVersionString>
    <CFBundleVersion Condition="'$(TargetFramework)' == 'net10.0' and '$(CFBundleVersion)' == ''">$(BuildTime)</CFBundleVersion>
    <!-- AVLN3001：Avalonia 提示"窗口没有 public 无参构造函数，XAML 不能被运行时加载器访问"。
         本项目的窗口都通过带参构造函数创建（如 GitSettingsWindow(settings)），设计时加载器用不到，
         属预期行为，故静默该提示以保持生成日志干净。 -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>

  <!-- 桌面 RID 防泄漏：Visual Studio 发布配置 / 命令行 -r 会把桌面 RuntimeIdentifier（win-x64 等）
       当全局属性传进来，它会连带作用到移动 TFM 的还原图，让 NuGet 去找并不存在的
       Microsoft.NETCore.App.Runtime.Mono.win-x64（NU1102，还原直接失败）。
       Project 上的 TreatAsLocalProperty 允许项目内复位该属性，这里只保留移动端自己的 RID（android* / ios*）。 -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-android' or '$(TargetFramework)' == 'net10.0-ios'">
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' != '' and !$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('android')) and !$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('ios'))" />
  </PropertyGroup>

  <!-- Windows 桌面：exe 文件图标（资源管理器 / 任务栏显示），必须是 .ico；
       只在桌面 TFM 生效（.ico 不是移动端合法的应用图标格式）。 -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT' and '$(TargetFramework)' == 'net10.0'">
    <ApplicationIcon>res\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- 桌面 Release 发布为【单文件可执行程序（依赖框架）】：Avalonia、Skia 等依赖全部打进主程序，
       输出目录只有 MultiGitCommit(.exe) + git 目录（不含 .NET 运行时，目标机器需已安装 .NET 10 运行时）。
       默认 RID 按构建主机决定；发布其他平台时用 -r 覆盖：
          dotnet publish -c Release -r osx-arm64   （Apple 芯片 Mac）
          dotnet publish -c Release -r osx-x64     （Intel Mac）
          dotnet publish -c Release -r linux-x64   （Linux x64）
          dotnet publish -c Release -r linux-arm64 （Linux ARM64）
       说明：单文件捆绑包的压缩只在独立模式（SelfContained）下支持，依赖框架模式不启用，故不设置。
       Debug 模式保持普通多文件输出，便于调试。
       移动端 TFM 不参与（apk / ipa 有自己的打包管线，PublishSingleFile 不适用）。 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(TargetFramework)' == 'net10.0'">
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- 默认 RID 按构建主机决定：Windows 用 win-x64，macOS（Rider / dotnet build -c Release）用 osx-arm64，
         Linux 用 linux-x64，避免在某一平台上默认产出另一平台的产物；需要其他架构时仍可用 -r 覆盖。 -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">osx-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">linux-x64</RuntimeIdentifier>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- Avalonia 11 跨平台 UI：
       Avalonia / Themes.Fluent 为全部 TFM 共用；
       Desktop 后端仅桌面；Android / iOS 后端仅对应移动 TFM（单项目模式）。 -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.11" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.11" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.11" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.11" Condition="'$(TargetFramework)' == 'net10.0' and '$(Configuration)' == 'Debug'" />
    <PackageReference Include="Avalonia.Android" Version="11.3.11" Condition="'$(TargetFramework)' == 'net10.0-android'" />
    <PackageReference Include="Avalonia.iOS" Version="11.3.11" Condition="'$(TargetFramework)' == 'net10.0-ios'" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.2" Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>

  <!-- 应用图标：以 Avalonia 资源嵌入，供窗口 / App 图标使用（桌面与移动共用同一份 png） -->
  <ItemGroup>
    <AvaloniaResource Include="res\icon.png" />
  </ItemGroup>

  <!-- 平台专属代码与资源（Platforms 目录约定）：SDK 不做自动过滤，按 TFM 显式 include，
       桌面 TFM 一律排除，避免移动端入口代码参与桌面编译。 -->
  <ItemGroup>
    <Compile Remove="Platforms/**" />
    <!-- MCP Server（原独立项目 src/MultiGitCommit.Mcp 已并入主项目）与 CLI（Cli/）仅桌面 net10.0 编译（依赖 Console、stdio 与桌面 git 子进程），桌面 Program.Main 按命令行参数分派；ConsoleAttach.cs 仅被这两处引用，一并排除。 -->
    <Compile Remove="Mcp/**;Cli/**;ConsoleAttach.cs" Condition="'$(TargetFramework)' != 'net10.0'" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <Compile Include="Platforms\Android\**\*.cs" />
    <AndroidResource Include="Platforms\Android\Resources\**\*" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-ios'">
    <Compile Include="Platforms\iOS\**\*.cs" />
  </ItemGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <AndroidManifest>Platforms\Android\AndroidManifest.xml</AndroidManifest>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-ios'">
    <InfoPlist>Platforms\iOS\Info.plist</InfoPlist>
  </PropertyGroup>

  <!-- 内嵌便携版 Git（随桌面版分发，开箱即用）：
       Windows：把 git 发行包放在 src/MultiGitCommit.Avalonia/git/（cmd\git.exe、mingw64\ 等）；
       macOS / Linux：放在 git/bin/git（Linux 需使用与目标发行版 glibc 兼容的可重定位构建）。
       构建时原样复制到输出目录 git\ 子目录，GitLocator 的 Embedded / Auto 模式会自动优先使用。
       目录不存在时此通配不匹配任何文件，不影响构建。
       移动端不打包（便携 Git 无 android / ios 版本；安卓内嵌方案见下一节）。 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <!-- ExcludeFromSingleFile：git 是数据目录，不能被打进 exe，必须保持为 exe 同级的 git\ 文件夹 -->
    <None Include="git\**\*" Visible="false" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- 安卓内嵌 Git：Termux 构建的 git 及依赖库重命名为 lib*.so，按 Abi 元数据打进 APK 的 lib\<abi>\ 目录
       （安装后位于 ApplicationInfo.NativeLibraryDir）。
       原因：Android 10+（targetSdk 29+）SELinux 禁止执行应用数据目录里的文件，
       原生库目录是应用唯一保持可执行的落点；
       安卓端运行时支撑（GIT_EXEC_PATH 符号链接、LD_LIBRARY_PATH、CA 证书）见 AndroidGitPlatform.cs。
       获取 / 重打包脚本：scripts/FetchAndroidGit.ps1（来源 packages.termux.dev，git 为 GPL-2.0）。
       注意：SDK 默认规则（EnableDefaultAndroidItems）会把项目内所有 **\*.so 自动包含为
       AndroidNativeLibrary，与本显式列表重复触发 XA4301 警告，所以必须先 Remove 再显式 include；
       显式 Abi 元数据是打包任务按 RID 过滤 lib\<abi> 的依据（CollectNativeFilesForArchive）。
       目录为空或缺失时通配不匹配任何文件，不影响构建。 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <AndroidNativeLibrary Remove="native-git\**\*.so" />
    <AndroidNativeLibrary Include="native-git\android\arm64-v8a\*.so">
      <Abi>arm64-v8a</Abi>
    </AndroidNativeLibrary>
    <AndroidNativeLibrary Include="native-git\android\x86_64\*.so">
      <Abi>x86_64</Abi>
    </AndroidNativeLibrary>
  </ItemGroup>

  <!-- 安卓内置中文字体：安卓系统没有 XAML 字体链声明的字体（微软雅黑 / PingFang / Source Han），
       且 Avalonia 11 的安卓 CJK 字形回退不可靠，中文会显示成方块。
       打包 Noto Sans CJK SC（SIL OFL 开源许可，许可文件见 Fonts/LICENSE），
       并在 MainActivity 的 FontManagerOptions.DefaultFamilyName 设为默认字体兜底。
       仅安卓 TFM 打包（iOS 系统自带 PingFang SC，无需内置，避免 ipa 增大 16MB）。 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <AvaloniaResource Include="Fonts\NotoSansCJKsc-Regular.otf" />
    <None Include="Fonts\LICENSE" Visible="false" />
  </ItemGroup>

</Project>
