<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>MultiGitCommit</string>
    <key>CFBundleIdentifier</key>
    <string>com.yylmzxc.multigitcommit</string>
    <!-- 不要在这里写 CFBundleShortVersionString / CFBundleVersion：
         plist 里的值会覆盖 csproj 的 ApplicationDisplayVersion / ApplicationVersion，
         版本号就退化成写死的 1.0 / 1，不再是构建时自动生成的日期与 dHHmm。 -->
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <!-- 声明现代启动屏幕（空 dict 即可）：缺失时 iOS 判定 App 为旧应用，
         进入兼容模式按旧分辨率渲染，上下留大黑边（letterbox），全屏无法铺满。 -->
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string></string>
    </dict>
    <!-- 把沙盒 Documents 暴露给系统「文件」App（我的 iPhone → MultiGitCommit）：
         iOS 沙盒不允许访问外部目录，默认仓库文件夹只有这样才能拷入 / 拷出现成仓库。 -->
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>
    <key>MinimumOSVersion</key>
    <string>15.0</string>
    <key>UIDeviceFamily</key>
    <array>
        <integer>1</integer>
        <integer>2</integer>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
</dict>
</plist>
