<!-- 主界面视图（桌面端嵌在 MainWindow 壳内；移动端由单视图生命周期直接承载）。
     标题栏 / 关闭时中止拉取等 Window 专属逻辑在 MainWindow 壳中处理。 -->
<UserControl x:Class="MultiGitCommit.MainView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MultiGitCommit"
             FontFamily="Microsoft YaHei UI,PingFang SC,Noto Sans CJK SC,Source Han Sans SC,DejaVu Sans" FontSize="13">

    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="4,2"/>
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#2B579A"/>
        </Style>
    </UserControl.Styles>

    <!-- 根布局：桌面端由 Window 提供有限高度，纵向滚动关闭，日志区（* 行）占满剩余空间、
         日志只在 TxtLog 内部滚动，避免日志文本撑高内容导致窗口 / 布局随输出变化；
         移动端（单视图生命周期，无 Window）在代码中改为 Auto 纵向滚动 + 日志区最小高度。
         对话框覆盖层放在 ScrollViewer 外，无论页面滚到哪里都盖满视口 -->
    <Grid>
        <ScrollViewer x:Name="RootScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
        <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 仓库目录 -->
            <RowDefinition Height="Auto"/>   <!-- 远端管理 -->
            <RowDefinition Height="Auto"/>   <!-- 提交设置 -->
            <RowDefinition Height="Auto"/>   <!-- 主按钮 -->
            <RowDefinition Height="Auto"/>   <!-- 手动命令 -->
            <RowDefinition Height="*"/>      <!-- 日志 -->
        </Grid.RowDefinitions>

        <!-- ============ 一、仓库目录区域 ============ -->
        <!-- 宽屏（桌面）：标签 + 路径框 + 一排按钮单行布局；
             窄屏（移动端）：按钮自动搬移到下方 WrapPanel 换行（见 ApplyResponsiveLayout） -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <Grid x:Name="RepoHeaderGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{DynamicResource L.MainView.L054.Text}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="TxtRepoPath" Grid.Column="1" VerticalContentAlignment="Center"
                     TextChanged="TxtRepoPath_TextChanged"
                     ToolTip.Tip="{DynamicResource L.MainView.L057.ToolTip_Tip}"/>
            <Button x:Name="BtnBrowse" Grid.Column="2" Content="{DynamicResource L.MainView.L058.Content}" Click="BtnBrowse_Click" Margin="6,2,4,2"/>
            <Button x:Name="BtnClone" Grid.Column="3" Content="{DynamicResource L.MainView.L059.Content}" Click="BtnClone_Click" Margin="4,2,0,2"
                    ToolTip.Tip="{DynamicResource L.MainView.L060.ToolTip_Tip}"/>
            <Button x:Name="BtnInitRepo" Grid.Column="4" Content="{DynamicResource L.MainView.L061.Content}" Click="BtnInitRepo_Click" Margin="4,2,0,2"
                    ToolTip.Tip="{DynamicResource L.MainView.L062.ToolTip_Tip}"/>
            <Button x:Name="BtnCreateBranch" Grid.Column="5" Content="{DynamicResource L.MainView.L063.Content}" Click="BtnCreateBranch_Click" Margin="4,2,0,2"
                    ToolTip.Tip="{DynamicResource L.MainView.L064.ToolTip_Tip}"/>
            <Button x:Name="BtnLoadConfig" Grid.Column="6" Content="{DynamicResource L.MainView.L065.Content}" Click="BtnLoadConfig_Click" Margin="4,2,0,2"
                    ToolTip.Tip="{DynamicResource L.MainView.L066.ToolTip_Tip}"/>
            <Button x:Name="BtnAbout" Grid.Column="7" Content="{DynamicResource L.MainView.L067.Content}" Click="BtnAbout_Click" Margin="4,2,0,2"
                    ToolTip.Tip="{DynamicResource L.MainView.L068.ToolTip_Tip}"/>
            <Button x:Name="BtnGitEnv" Grid.Column="8" Content="{DynamicResource L.MainView.L069.Content}" Click="BtnGitEnv_Click" Margin="4,2,0,2"
                    ToolTip.Tip="{DynamicResource L.MainView.L070.ToolTip_Tip}"/>
            <Button x:Name="BtnRepoHome" Grid.Column="9" Content="{DynamicResource L.MainView.L071.Content}" Click="BtnRepoHome_Click" Margin="4,2,0,2"
                    ToolTip.Tip="{DynamicResource L.MainView.L072.ToolTip_Tip}"/>
            </Grid>
            <WrapPanel x:Name="RepoHeaderNarrow" IsVisible="False"/>
        </StackPanel>

        <!-- ============ 二、远端地址管理区域 ============ -->
        <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Classes="sectionTitle" TextWrapping="Wrap"
                           Text="{DynamicResource L.MainView.L086.Text}" Margin="0,0,0,6"/>
                <WrapPanel Grid.Row="1" HorizontalAlignment="Right">
                    <Button x:Name="BtnAddRemote" Content="{DynamicResource L.MainView.L088.Content}" Click="BtnAddRemote_Click"/>
                    <Button x:Name="BtnEditRemote" Content="{DynamicResource L.MainView.L089.Content}" IsEnabled="False" Click="BtnEditRemote_Click"/>
                    <Button x:Name="BtnDeleteRemote" Content="{DynamicResource L.MainView.L090.Content}" IsEnabled="False" Click="BtnDeleteRemote_Click"/>
                    <Button x:Name="BtnOpenRemote" Content="{DynamicResource L.MainView.L091.Content}" IsEnabled="False" Click="BtnOpenRemote_Click"
                            ToolTip.Tip="{DynamicResource L.MainView.L092.ToolTip_Tip}"/>
                </WrapPanel>
                <ListBox x:Name="ListRemotes" Grid.Row="2" Height="120" Margin="0,4,0,0"
                         SelectionChanged="ListRemotes_SelectionChanged"
                         ToolTip.Tip="{DynamicResource L.MainView.L096.ToolTip_Tip}"/>
            </Grid>
        </Border>

        <!-- ============ 三、提交相关输入控件 ============ -->
        <Border Grid.Row="2" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Classes="sectionTitle" Text="{DynamicResource L.MainView.L108.Text}" Margin="0,0,0,6"/>
                <Grid Grid.Row="1" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource L.MainView.L114.Text}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="TxtCommitMessage" Grid.Column="1" VerticalContentAlignment="Center"
                             ToolTip.Tip="{DynamicResource L.MainView.L116.ToolTip_Tip}"/>
                </Grid>
                <!-- WrapPanel：四个复选框总宽超过默认窗口宽度，窄窗口时自动换行，避免【强制推送】被裁掉 -->
                <WrapPanel Grid.Row="2">
                    <CheckBox x:Name="ChkAddAll" Content="{DynamicResource L.MainView.L120.Content}" Margin="0,2,20,2"
                              ToolTip.Tip="{DynamicResource L.MainView.L121.ToolTip_Tip}"
                              IsCheckedChanged="ChkAddAll_Changed"/>
                    <CheckBox x:Name="ChkPushTags" Content="{DynamicResource L.MainView.L123.Content}" Margin="0,2,20,2"
                              IsCheckedChanged="ChkPushTags_Changed"/>
                    <CheckBox x:Name="ChkForceCommit" Content="{DynamicResource L.MainView.L125.Content}" Margin="0,2,20,2"
                              ToolTip.Tip="{DynamicResource L.MainView.L126.ToolTip_Tip}"
                              IsCheckedChanged="ChkForceCommit_Changed"/>
                    <CheckBox x:Name="ChkForcePush" Content="{DynamicResource L.MainView.L128.Content}" Margin="0,2,0,2" Foreground="#C00000"
                              ToolTip.Tip="{DynamicResource L.MainView.L129.ToolTip_Tip}"
                              IsCheckedChanged="ChkForcePush_Changed"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ============ 四、主执行按钮 ============ -->
        <WrapPanel Grid.Row="3" Margin="0,0,0,8">
            <Button x:Name="BtnCommitPush" Content="{DynamicResource L.MainView.L137.Content}" Width="250" Height="38"
                    FontSize="15" FontWeight="Bold" Click="BtnCommitPush_Click"/>
            <Button x:Name="BtnPull" Content="{DynamicResource L.MainView.L139.Content}" Height="38" Padding="12,4" Margin="8,2,0,2"
                    Click="BtnPull_Click"
                    ToolTip.Tip="{DynamicResource L.MainView.L141.ToolTip_Tip}"/>
            <TextBlock x:Name="TxtBranchInfo" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#666"
                       MaxWidth="160" TextTrimming="CharacterEllipsis"/>
            <!-- 提交身份：git 生成 commit 的前置条件，未设置时提交前会自动弹窗引导填写 -->
            <TextBlock x:Name="TxtIdentity" VerticalAlignment="Center" Margin="20,0,0,0" Foreground="#666"
                       MaxWidth="240" TextTrimming="CharacterEllipsis"
                       Text="{DynamicResource L.MainView.L147.Text}"
                       ToolTip.Tip="{DynamicResource L.MainView.L148.ToolTip_Tip}"/>
            <Button x:Name="BtnIdentity" Content="{DynamicResource L.MainView.L149.Content}" Click="BtnIdentity_Click" Padding="10,2" Margin="8,0,0,0"
                    ToolTip.Tip="{DynamicResource L.MainView.L150.ToolTip_Tip}"/>
            <Button x:Name="BtnHistory" Content="{DynamicResource L.MainView.L151.Content}" Click="BtnHistory_Click" Padding="10,2" Margin="8,0,0,0"
                    ToolTip.Tip="{DynamicResource L.MainView.L152.ToolTip_Tip}"/>
        </WrapPanel>

        <!-- ============ 五、手动命令执行区 ============ -->
        <Border Grid.Row="4" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Classes="sectionTitle" TextWrapping="Wrap"
                           Text="{DynamicResource L.MainView.L163.Text}" Margin="0,0,0,6"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtCommand" Grid.Column="0" VerticalContentAlignment="Center"
                             ToolTip.Tip="{DynamicResource L.MainView.L170.ToolTip_Tip}"
                             KeyDown="TxtCommand_KeyDown"/>
                    <Button x:Name="BtnRunCommand" Grid.Column="1" Content="{DynamicResource L.MainView.L172.Content}" Click="BtnRunCommand_Click" Margin="6,2,0,2"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ============ 六、日志输出区 ============ -->
        <Border Grid.Row="5" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Classes="sectionTitle" Text="{DynamicResource L.MainView.L185.Text}" Margin="0,0,0,6"/>
                <Border x:Name="LogFrame" Grid.Row="1" BorderBrush="#444" BorderThickness="1" Background="#1E1E1E">
                    <!-- TextWrapping 默认 NoWrap（桌面列对齐）；窄屏（手机竖屏）由
                         ApplyResponsiveLayout 在运行时切为 Wrap，长行自动折行 -->
                    <TextBox x:Name="TxtLog"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             Background="#1E1E1E" Foreground="#DCDCDC"
                             BorderThickness="0"
                             FontFamily="Consolas,Menlo,DejaVu Sans Mono,Noto Sans Mono" FontSize="12">
                        <!-- Fluent 主题会按控件状态（悬停 / 聚焦 / 禁用）换掉 TextBox 的背景与边框，
                             这些状态样式写在控件模板内部元素上，直接设 Background 属性挡不住，
                             因此在这里覆盖同名主题资源，让日志区在任何状态下都保持深色。 -->
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#1E1E1E"/>
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1E1E1E"/>
                            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#1E1E1E"/>
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#1E1E1E"/>
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#1E1E1E"/>
                        </TextBox.Resources>
                        <TextBox.Styles>
                            <!-- 双保险：万一主题未使用上述资源名，直接改模板内边框的背景 -->
                            <Style Selector="TextBox:pointerover /template/ Border">
                                <Setter Property="Background" Value="#1E1E1E"/>
                            </Style>
                            <Style Selector="TextBox:focus /template/ Border">
                                <Setter Property="Background" Value="#1E1E1E"/>
                            </Style>
                        </TextBox.Styles>
                    </TextBox>
                </Border>
                <WrapPanel Grid.Row="2" Margin="0,4,0,0" HorizontalAlignment="Left">
                    <Button x:Name="BtnCopyLog" Content="{DynamicResource L.MainView.L218.Content}" Click="BtnCopyLog_Click" Padding="10,2"
                            ToolTip.Tip="{DynamicResource L.MainView.L219.ToolTip_Tip}"/>
                    <Button x:Name="BtnClearLog" Content="{DynamicResource L.MainView.L220.Content}" Click="BtnClearLog_Click" Padding="10,2"/>
                    <CheckBox x:Name="ChkAutoScroll" Content="{DynamicResource L.MainView.L221.Content}" IsChecked="True" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBlock x:Name="TxtGitStatus" VerticalAlignment="Center" Margin="20,0,0,0" Foreground="#666"
                               TextTrimming="CharacterEllipsis" MaxWidth="560"
                               ToolTip.Tip="{DynamicResource L.MainView.L224.ToolTip_Tip}"/>
                </WrapPanel>
            </Grid>
        </Border>

        </Grid>
        </ScrollViewer>

        <!-- ============ 仓库管理首页覆盖层 ============ -->
        <!-- 用户未打开项目时默认加载，也可从上方【仓库管理】按钮随时进入；
             必须声明在对话框覆盖层（Overlay）之前，保证弹窗始终盖在本页之上 -->
        <local:RepoHomeView x:Name="HomeView" IsVisible="False"/>

        <!-- ============ 对话框覆盖层（移动端宿主；桌面端不使用） ============ -->
        <!-- 放在 ScrollViewer 外：页面滚动时覆盖层始终盖满整个视口 -->
        <local:DialogOverlay x:Name="Overlay" ZIndex="100"/>
    </Grid>
</UserControl>
