<UserControl x:Class="MultiGitCommit.PullView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="640" MinHeight="460"
             FontFamily="Microsoft YaHei UI,PingFang SC,Noto Sans CJK SC,Source Han Sans SC,DejaVu Sans" FontSize="13">

    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="4,2"/>
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="14">

        <!-- 底部按钮栏：始终可见 -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnStart" Content="{DynamicResource L.PullView.L019.Content}" Width="100" IsDefault="True" Click="BtnOk_Click"/>
            <Button Content="{DynamicResource L.PullView.L020.Content}" Width="80" IsCancel="True" Click="BtnCancel_Click"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="{DynamicResource L.PullView.L025.Text}" FontWeight="Bold" FontSize="14" Foreground="#2B579A"/>

                <TextBlock Text="{DynamicResource L.PullView.L027.Text}" Margin="0,10,0,2" Foreground="#666"/>
                <TextBox x:Name="TxtRepo" IsReadOnly="True" VerticalContentAlignment="Center"/>

                <TextBlock Text="{DynamicResource L.PullView.L030.Text}" Margin="0,8,0,2" Foreground="#666"/>
                <TextBox x:Name="TxtBranch" IsReadOnly="True" VerticalContentAlignment="Center"/>

                <TextBlock Text="{DynamicResource L.PullView.L033.Text}" Margin="0,8,0,2" Foreground="#666"/>
                <ComboBox x:Name="CmbRemote" HorizontalAlignment="Stretch"
                          ToolTip.Tip="{DynamicResource L.PullView.L035.ToolTip_Tip}"/>

                <TextBlock Text="{DynamicResource L.PullView.L037.Text}" Margin="0,12,0,4" FontWeight="SemiBold"/>
                <!-- 单选文案在窄屏需要换行，否则长句会把整行撑出视口 -->
                <RadioButton x:Name="RbFf" Margin="0,3" IsChecked="True">
                    <TextBlock Text="{DynamicResource L.PullView.L040.Text}" TextWrapping="Wrap"/>
                </RadioButton>
                <RadioButton x:Name="RbRebase" Margin="0,3">
                    <TextBlock Text="{DynamicResource L.PullView.L043.Text}" TextWrapping="Wrap"/>
                </RadioButton>
                <RadioButton x:Name="RbMerge" Margin="0,3">
                    <TextBlock Text="{DynamicResource L.PullView.L046.Text}" TextWrapping="Wrap"/>
                </RadioButton>

                <TextBlock TextWrapping="Wrap" Foreground="#888" Margin="0,12,0,0"
                           Text="{DynamicResource L.PullView.L050.Text}"/>

                <TextBlock x:Name="TxtError" Foreground="#B00020" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
