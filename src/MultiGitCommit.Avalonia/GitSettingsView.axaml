<UserControl x:Class="MultiGitCommit.GitSettingsView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="700" MinHeight="560"
             FontFamily="Microsoft YaHei UI,PingFang SC,Noto Sans CJK SC,Source Han Sans SC,DejaVu Sans" FontSize="13">

    <!-- DockPanel：底部按钮栏固定，中间内容区可滚动。
         顺序重要：最后一个子元素（ScrollViewer）会占满剩余空间。 -->
    <DockPanel>

        <!-- 底部按钮栏：始终可见，不随内容滚动 -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="14,8,14,14">
            <Button Content="确定" Width="80" IsDefault="True" Padding="8,2" Click="BtnOk_Click"/>
            <Button Content="取消" Width="80" IsCancel="True" Margin="8,0,0,0" Padding="8,2" Click="BtnCancel_Click"/>
        </StackPanel>

        <!-- 中间内容区：ScrollViewer 包裹，高度超出时可滚动 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="14,14,14,6">
            <StackPanel>

                <!-- ============ 第一组：Git 来源 ============ -->
                <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10">
                    <StackPanel Margin="12">
                        <TextBlock Text="Git 来源" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                        <TextBlock Text="选择本工具执行 git 命令所用的 git 来源（不依赖系统是否安装 / 配置 git）："
                                   TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#666"/>

                        <RadioButton x:Name="RbAuto" Content="自动检测（推荐）：软件内嵌 Git → 常见安装位置 → 系统 PATH"
                                     Margin="0,3" IsCheckedChanged="Mode_Changed"/>
                        <RadioButton x:Name="RbEmbedded" Content="仅使用软件内嵌的 Git"
                                     Margin="0,3" IsCheckedChanged="Mode_Changed"/>
                        <RadioButton x:Name="RbSystem" Content="仅使用系统 PATH 环境变量中的 git（环境 git）"
                                     Margin="0,3" IsCheckedChanged="Mode_Changed"/>
                        <RadioButton x:Name="RbCustom" Content="指定 git 可执行文件或 Git 目录（软件自带 / 便携版 Git）"
                                     Margin="0,3" IsCheckedChanged="Mode_Changed"/>

                        <Grid Margin="20,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtCustomPath" Grid.Column="0" VerticalContentAlignment="Center"
                                     ToolTip.Tip="git 可执行文件完整路径，或 Git 安装 / 解压根目录（自动查找其中的 bin/git、cmd/git、libexec/git-core/git）"/>
                            <Button x:Name="BtnBrowse" Grid.Column="1" Content="浏览..." Margin="6,0,0,0"
                                    Padding="10,2" Click="BtnBrowse_Click"
                                    ToolTip.Tip="选择 git 可执行文件；若想指定 Git 根目录请直接粘贴目录路径"/>
                        </Grid>

                        <Button x:Name="BtnTest" Content="测试当前所选配置" HorizontalAlignment="Left"
                                Padding="10,2" Margin="0,10,0,0" Click="BtnTest_Click"/>

                        <TextBlock x:Name="TxtResult" TextWrapping="Wrap" Margin="0,8,0,0"
                                   MinHeight="18" Foreground="#666"/>
                    </StackPanel>
                </Border>

                <!-- ============ 第二组：提交身份 ============ -->
                <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10">
                    <StackPanel Margin="12">
                        <TextBlock Text="提交身份（git user.name / user.email）" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                        <TextBlock Text="生成 commit 的前置条件：二者缺一时 git 直接报错，根本生成不了提交。未配置时，首次提交会自动弹窗引导填写。"
                                   TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#666"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtIdentityInfo" VerticalAlignment="Center" Foreground="#666"/>
                            <Button x:Name="BtnIdentity" Content="设置提交身份…" Padding="10,2" Margin="10,0,0,0" Click="BtnIdentity_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtIdentityResult" TextWrapping="Wrap" Margin="0,6,0,0"
                                   MinHeight="18" Foreground="#666"/>
                    </StackPanel>
                </Border>

                <!-- ============ 文件添加方式（git add） ============ -->
                <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10">
                    <StackPanel Margin="12">
                        <TextBlock Text="执行 git add 时的文件添加方式" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                        <TextBlock Text="主界面勾选了【执行 git add】后，提交前按这里的选择添加文件（默认全提交，不需要每次确认）："
                                   TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#666"/>

                        <RadioButton x:Name="RbStageAll" Margin="0,3" IsCheckedChanged="StageMode_Changed"
                                     Content="全提交（默认，推荐）：直接执行 git add .，添加工作区全部变更，不弹窗"/>
                        <RadioButton x:Name="RbStageSelect" Margin="0,3" IsCheckedChanged="StageMode_Changed"
                                     Content="可选提交：先列出工作区变更，由你勾选要添加的文件，只对勾选项执行 git add"/>

                        <TextBlock x:Name="TxtStageHint" TextWrapping="Wrap" Margin="0,8,0,0"
                                   MinHeight="18" Foreground="#888" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- ============ 第二组：启动时加载的仓库 ============ -->
                <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10">
                    <StackPanel Margin="12">
                        <TextBlock Text="启动时加载的仓库" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                        <TextBlock Text="决定软件启动时自动填入哪个仓库目录（改动在下次启动时生效）："
                                   TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#666"/>

                        <RadioButton x:Name="RbStartupCurrent" Content="当前目录优先（推荐）：当前目录或其上级目录是 Git 仓库时直接加载它"
                                     Margin="0,3" IsCheckedChanged="StartupMode_Changed"/>
                        <RadioButton x:Name="RbStartupLast" Content="上次使用的仓库优先：始终打开上次成功加载的仓库"
                                     Margin="0,3" IsCheckedChanged="StartupMode_Changed"/>

                        <TextBlock x:Name="TxtStartupHint" TextWrapping="Wrap" Margin="0,8,0,0"
                                   MinHeight="18" Foreground="#888" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- ============ 第三组：推送凭据 / 账号 ============ -->
                <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Margin="0,0,0,4">
                    <StackPanel Margin="12">
                        <TextBlock Text="推送凭据 / 账号（https 远端免交互推送用，按主机匹配，可配置多个）"
                                   FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                        <TextBlock Text="工具为非交互执行（禁用终端提示），https 远端没有账号时 git 无法弹窗询问，推送必然失败。可选择账号来源："
                                   TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#666"/>

                        <RadioButton x:Name="RbCredAuto" Content="自动检测（推荐）：优先使用已保存的账号，缺失时自动从系统凭据获取"
                                     IsCheckedChanged="CredMode_Changed" Margin="0,3"/>
                        <RadioButton x:Name="RbCredSystem" Content="仅使用系统凭据：每次推送实时向系统凭据库（凭据管理器 / 钥匙串 / Secret Service）索取（令牌不保存到配置文件）"
                                     IsCheckedChanged="CredMode_Changed" Margin="0,3"/>
                        <RadioButton x:Name="RbCredCustom" Content="仅使用自定义账号：只用下方保存的凭据，不访问系统"
                                     IsCheckedChanged="CredMode_Changed" Margin="0,3"/>
                        <RadioButton x:Name="RbCredNone" Content="不使用凭据：ssh 远端，或已自行配置（ssh-agent / URL 内已带账号）"
                                     IsCheckedChanged="CredMode_Changed" Margin="0,3"/>

                        <TextBlock Text="自定义账号列表（按主机匹配，可配置多个；点【检测系统凭据】可把系统已保存的账号导入到这里）"
                                   Margin="0,10,0,4"/>
                        <TextBlock Text="填入平台的用户名与访问令牌，推送时自动注入 URL（令牌在日志中显示为 ***）。"
                                   TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#666"/>

                        <ListBox x:Name="ListCred" Height="90" SelectionChanged="ListCred_SelectionChanged"/>

                        <!-- 平台预设：选平台自动填主机名（CNB 还固定用户名 cnb），避免手打域名出错 -->
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="平台：" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbPlatform" Grid.Column="1" Margin="6,0,0,0" MinWidth="150"
                                      SelectedIndex="3"
                                      SelectionChanged="CmbPlatform_SelectionChanged"
                                      ToolTip.Tip="选择平台会自动填入主机名与用户名规则；也可选“自定义”手动填写">
                                <ComboBoxItem Content="Gitee（gitee.com）" Tag="gitee.com"/>
                                <ComboBoxItem Content="GitHub（github.com）" Tag="github.com"/>
                                <ComboBoxItem Content="CNB 云原生构建（cnb.cool）" Tag="cnb.cool"/>
                                <ComboBoxItem Content="自定义（手动填写主机）" Tag=""/>
                            </ComboBox>
                            <Button x:Name="BtnPlatformToken" Grid.Column="2" Content="获取访问令牌" Padding="10,2" Margin="6,0,0,0"
                                    IsEnabled="False" Click="BtnPlatformToken_Click"
                                    ToolTip.Tip="用浏览器打开当前平台的访问令牌创建页面"/>
                        </Grid>

                        <TextBlock x:Name="TxtPlatformHint" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="#888" FontSize="11"/>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtCredHost" Grid.Column="0" VerticalContentAlignment="Center"
                                     Watermark="主机，如 cnb.cool"
                                     ToolTip.Tip="远端主机名（cnb.cool / gitee.com / github.com），也可直接粘贴完整 URL"/>
                            <TextBox x:Name="TxtCredUser" Grid.Column="1" Margin="6,0,0,0" VerticalContentAlignment="Center"
                                     Watermark="用户名" ToolTip.Tip="平台账号名"/>
                            <TextBox x:Name="TxtCredToken" Grid.Column="2" Margin="6,0,0,0" VerticalContentAlignment="Center"
                                     Watermark="访问令牌 / 密码" PasswordChar="*"
                                     ToolTip.Tip="平台的访问令牌（Personal Access Token），不要填登录密码以外的敏感口令"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="BtnCredTest" Content="验证账号" Padding="10,2" Click="BtnCredTest_Click"
                                    ToolTip.Tip="用一次 git ls-remote 实测该账号能否通过服务端认证（最多 20 秒，可随时取消）"/>
                            <Button x:Name="BtnCredAdd" Content="添加/更新" Padding="10,2" Margin="6,0,0,0" Click="BtnCredAdd_Click"/>
                            <Button x:Name="BtnCredDelete" Content="删除" Padding="10,2" Margin="6,0,0,0" Click="BtnCredDelete_Click"/>
                            <Button x:Name="BtnCredDetect" Content="检测系统凭据…" Padding="10,2" Margin="6,0,0,0" Click="BtnCredDetect_Click"
                                    ToolTip.Tip="打开检测窗口：自行选择要检测的主机，再按需导入（可随时停止，不会全量扫描）"/>
                        </StackPanel>

                        <!-- 账号操作的结果独立显示：不与上方 Git 配置测试结果共用一行 -->
                        <TextBlock x:Name="TxtCredResult" TextWrapping="Wrap" Margin="0,8,0,0"
                                   MinHeight="18" Foreground="#666"/>

                        <TextBlock Text="凭据助手（credential.helper）"
                                   Margin="0,12,0,4" FontWeight="SemiBold"/>
                        <TextBlock Text="按当前已生效的 git 检测；点【确定】保存新的 git 来源后会重新检测。"
                                   TextWrapping="Wrap" Margin="0,0,0,4" Foreground="#888" FontSize="11"/>
                        <TextBlock x:Name="TxtHelperInfo" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#666"
                                   ToolTip.Tip="git 取用系统保存的账号所依赖的助手；若配置的助手在当前 git 中不存在（常见于精简便携版），推送时会报 'credential-manager' is not a git command"/>

                        <TextBlock Text="凭据明文保存在应用设置目录的 settings.json"
                                   Margin="0,6,0,0" Foreground="#888" FontSize="11"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
