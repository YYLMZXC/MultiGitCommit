<UserControl x:Class="MultiGitCommit.GitSettingsView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="700" MinHeight="500"
             FontFamily="Microsoft YaHei UI,PingFang SC,Noto Sans CJK SC,Source Han Sans SC,DejaVu Sans" FontSize="13">

    <!--
      设置页信息架构（按用户任务排布，而不是按配置类字段平铺）：
        1. 提交身份       —— 人人都要配，默认展开
        2. 基础行为       —— 少量人改，默认展开
        3. 高级设置       —— 极少数人需要，默认收起（渐进式披露）
      文字层级：板块大标题 > 选项标题 / 字段标签 > 辅助说明小字 > 提示日志文本。
      颜色一律用「主题前景 + 不透明度」或半透明中性灰，浅色 / 深色主题下都可读。
    -->
    <UserControl.Styles>
        <Style Selector="TextBlock.page-title">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.subsection-title">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.85"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style Selector="TextBlock.section-sub">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Opacity" Value="0.72"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Opacity" Value="0.72"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.log">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Opacity" Value="0.92"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="RadioButton.option">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="BorderBrush" Value="#D8DEE6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style Selector="Border.subcard">
            <Setter Property="Background" Value="#0C808080"/>
            <Setter Property="BorderBrush" Value="#E3E7ED"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style Selector="Border.note">
            <Setter Property="Background" Value="#14808080"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
        <Style Selector="Border.log-box">
            <Setter Property="Background" Value="#1A808080"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <!-- 窄屏（手机）紧凑变体：三层容器每侧内边距合计高达 48px，内容只剩约 300px；
             窄屏时由 ApplyResponsiveLayout 给容器加 compact 类，把内边距让给内容 -->
        <Style Selector="Border.card.compact">
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style Selector="Border.subcard.compact">
            <Setter Property="Padding" Value="10"/>
        </Style>
    </UserControl.Styles>

    <!-- DockPanel：底部按钮栏固定，中间内容区可滚动；最后一个子元素占满剩余空间。 -->
    <DockPanel>

        <!-- 底部按钮栏：始终可见，不随内容滚动 -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#D8DEE6" BorderThickness="0,1,0,0" Padding="18,10">
            <Grid ColumnDefinitions="*,Auto">
                <!-- 左侧：数据目录入口（移动端不支持系统文件管理器，隐藏按钮但仍显示路径） -->
                <Grid Grid.Column="0" ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                    <Button x:Name="BtnOpenDataDir" Content="{DynamicResource L.GitSettingsView.OpenDataDir.Content}"
                            Padding="8,3" Click="BtnOpenDataDir_Click"
                            ToolTip.Tip="{DynamicResource L.GitSettingsView.OpenDataDir.ToolTip_Tip}"/>
                    <!-- 用 Grid 的 * 列约束宽度，长路径只省略显示，不会挤到右侧的确定/取消按钮 -->
                    <TextBlock x:Name="TxtDataDirPath" Grid.Column="1" Classes="hint" Margin="8,0,0,0" VerticalAlignment="Center"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource L.GitSettingsView.L096.Content}" Width="88" IsDefault="True" Padding="8,3" Click="BtnOk_Click"/>
                    <Button Content="{DynamicResource L.GitSettingsView.L097.Content}" Width="80" IsCancel="True" Margin="8,0,0,0" Padding="8,3" Click="BtnCancel_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="ContentScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="18,16,18,12">
            <StackPanel>

                <TextBlock Text="{DynamicResource L.GitSettingsView.L107.Text}" Classes="page-title"/>
                <TextBlock Classes="section-sub" Margin="0,4,0,16"
                           Text="{DynamicResource L.GitSettingsView.L109.Text}"/>

                <!-- ============ 第一块：提交身份（默认展开，所有人都用） ============ -->
                <Border x:Name="IdentityCard" Classes="card">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.GitSettingsView.L114.Text}" Classes="section-title"/>
                        <TextBlock Text="git user.name / user.email" Classes="section-sub" Margin="0,2,0,0"/>
                        <TextBlock Classes="hint" Margin="0,6,0,0"
                                   Text="{DynamicResource L.GitSettingsView.L117.Text}"/>

                        <!-- 标签在上、输入框在下；窄屏（移动端）由 ApplyResponsiveLayout 改为逐行排列 -->
                        <Grid x:Name="IdentityInputGrid" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel x:Name="IdentityNameField" Grid.Row="0" Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="{DynamicResource L.GitSettingsView.L134.Text}" Classes="field-label"/>
                                <TextBox x:Name="TxtIdentityName" VerticalContentAlignment="Center"
                                         Watermark="{DynamicResource L.GitSettingsView.L136.Watermark}"
                                         ToolTip.Tip="{DynamicResource L.GitSettingsView.L137.ToolTip_Tip}"/>
                            </StackPanel>

                            <StackPanel x:Name="IdentityEmailField" Grid.Row="0" Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="{DynamicResource L.GitSettingsView.L141.Text}" Classes="field-label"/>
                                <TextBox x:Name="TxtIdentityEmail" VerticalContentAlignment="Center"
                                         Watermark="name@example.com"
                                         ToolTip.Tip="{DynamicResource L.GitSettingsView.L144.ToolTip_Tip}"/>
                            </StackPanel>

                            <WrapPanel x:Name="IdentityActionRow" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                       Margin="0,12,0,0">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="{DynamicResource L.GitSettingsView.L150.Text}" Classes="field-label"/>
                                    <ComboBox x:Name="CmbIdentityScope" Width="170" SelectedIndex="0"
                                              ToolTip.Tip="{DynamicResource L.GitSettingsView.L152.ToolTip_Tip}">
                                        <ComboBoxItem x:Name="CmbIdentityScopeLocal" Content="{DynamicResource L.GitSettingsView.L153.Content}"/>
                                        <ComboBoxItem Content="{DynamicResource L.GitSettingsView.L154.Content}"/>
                                    </ComboBox>
                                </StackPanel>
                                <Button x:Name="BtnIdentity" Content="{DynamicResource L.GitSettingsView.L157.Content}" MinWidth="78" Padding="14,4"
                                        VerticalAlignment="Bottom" Margin="0,0,10,0"
                                        Click="BtnIdentity_Click"/>
                                <TextBlock x:Name="TxtIdentityScopeHint" Classes="hint" MaxWidth="330"
                                           VerticalAlignment="Bottom" Margin="0,0,0,5"
                                           Text="{DynamicResource L.GitSettingsView.L162.Text}"/>
                            </WrapPanel>

                            <TextBlock x:Name="TxtIdentityInfo" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                       Classes="log" Margin="0,10,0,0" TextWrapping="Wrap" MinHeight="16"/>
                            <Border x:Name="IdentityResultBox" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Classes="log-box">
                                <TextBlock x:Name="TxtIdentityResult" Classes="log" MinHeight="14"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ 第二块：基础行为（默认展开，少量人会改） ============ -->
                <Border x:Name="StageCard" Classes="card">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.GitSettingsView.L177.Text}" Classes="section-title"/>
                        <TextBlock Text="{DynamicResource L.GitSettingsView.L178.Text}" Classes="section-sub" Margin="0,2,0,0"/>

                        <StackPanel Margin="0,12,0,0">
                            <RadioButton x:Name="RbStageAll" Classes="option" IsCheckedChanged="StageMode_Changed">
                                <TextBlock Text="{DynamicResource L.GitSettingsView.L182.Text}" TextWrapping="Wrap"/>
                            </RadioButton>
                            <RadioButton x:Name="RbStageSelect" Classes="option" IsCheckedChanged="StageMode_Changed">
                                <TextBlock Text="{DynamicResource L.GitSettingsView.L185.Text}" TextWrapping="Wrap"/>
                            </RadioButton>
                        </StackPanel>

                        <!-- 组底部统一备注：单选只保留短标题，说明文字下沉到这里 -->
                        <Border Classes="note">
                            <TextBlock x:Name="TxtStageHint" Classes="hint" MinHeight="16"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ============ 第三块：界面语言（文案由 Loc 在 code-behind 赋值，切换后即时生效） ============ -->
                <Border x:Name="LanguageCard" Classes="card">
                    <StackPanel>
                        <TextBlock x:Name="TxtLanguageTitle" Classes="section-title"/>
                        <TextBlock x:Name="TxtLanguageHint" Classes="section-sub" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        <ComboBox x:Name="CmbLanguage" Margin="0,10,0,0" MinWidth="200"/>
                    </StackPanel>
                </Border>

                <!-- ============ 第四块：高级设置（默认收起，渐进式披露） ============ -->
                <Expander x:Name="AdvancedExpander" IsExpanded="False"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Margin="0,4,0,8">
                    <Expander.Header>
                        <StackPanel Margin="0,2">
                            <TextBlock Text="{DynamicResource L.GitSettingsView.L202.Text}" Classes="section-title"/>
                            <TextBlock Classes="section-sub" Margin="0,2,0,0"
                                       Text="{DynamicResource L.GitSettingsView.L204.Text}"/>
                        </StackPanel>
                    </Expander.Header>

                    <StackPanel Margin="0,10,0,0">

                        <!--  高级 1：Git 程序来源  -->
                        <Border x:Name="SrcCard" Classes="subcard">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L.GitSettingsView.L213.Text}" Classes="subsection-title"/>
                                <TextBlock Classes="hint" Margin="0,4,0,10"
                                           Text="{DynamicResource L.GitSettingsView.L215.Text}"/>

                                <RadioButton x:Name="RbAuto" Classes="option" IsCheckedChanged="Mode_Changed">
                                    <TextBlock Text="{DynamicResource L.GitSettingsView.L218.Text}" TextWrapping="Wrap"/>
                                </RadioButton>
                                <RadioButton x:Name="RbEmbedded" Classes="option" IsCheckedChanged="Mode_Changed">
                                    <TextBlock Text="{DynamicResource L.GitSettingsView.L221.Text}" TextWrapping="Wrap"/>
                                </RadioButton>
                                <RadioButton x:Name="RbSystem" Classes="option" IsCheckedChanged="Mode_Changed">
                                    <TextBlock Text="{DynamicResource L.GitSettingsView.L224.Text}" TextWrapping="Wrap"/>
                                </RadioButton>
                                <RadioButton x:Name="RbCustom" Classes="option" IsCheckedChanged="Mode_Changed">
                                    <TextBlock Text="{DynamicResource L.GitSettingsView.L227.Text}" TextWrapping="Wrap"/>
                                </RadioButton>

                                <!-- 依赖区：只有选「指定路径」才可用，其余情况整块灰度 -->
                                <StackPanel x:Name="CustomPathPanel" Margin="24,8,0,0" IsEnabled="False" Opacity="0.45">
                                    <TextBlock Text="{DynamicResource L.GitSettingsView.L232.Text}" Classes="field-label"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtCustomPath" Grid.Column="0" VerticalContentAlignment="Center"
                                                 ToolTip.Tip="{DynamicResource L.GitSettingsView.L239.ToolTip_Tip}"/>
                                        <Button x:Name="BtnBrowse" Grid.Column="1" Content="{DynamicResource L.GitSettingsView.L240.Content}" Margin="6,0,0,0"
                                                Padding="10,3" Click="BtnBrowse_Click"
                                                ToolTip.Tip="{DynamicResource L.GitSettingsView.L242.ToolTip_Tip}"/>
                                    </Grid>
                                </StackPanel>

                                <WrapPanel Margin="0,12,0,0">
                                    <Button x:Name="BtnTest" Content="{DynamicResource L.GitSettingsView.L247.Content}" Padding="10,3"
                                            Click="BtnTest_Click"/>
                                </WrapPanel>

                                <Border Classes="note">
                                    <TextBlock Classes="hint"
                                               Text="{DynamicResource L.GitSettingsView.L253.Text}"/>
                                </Border>
                                <Border Classes="log-box">
                                    <TextBlock x:Name="TxtResult" Classes="log" MinHeight="14"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!--  高级 2：启动仓库加载策略  -->
                        <Border x:Name="StartupCard" Classes="subcard">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L.GitSettingsView.L264.Text}" Classes="subsection-title"/>
                                <TextBlock Classes="hint" Margin="0,4,0,10"
                                           Text="{DynamicResource L.GitSettingsView.L266.Text}"/>

                                <RadioButton x:Name="RbStartupCurrent" Classes="option" IsCheckedChanged="StartupMode_Changed">
                                    <TextBlock Text="{DynamicResource L.GitSettingsView.L269.Text}" TextWrapping="Wrap"/>
                                </RadioButton>
                                <RadioButton x:Name="RbStartupLast" Classes="option" IsCheckedChanged="StartupMode_Changed">
                                    <TextBlock Text="{DynamicResource L.GitSettingsView.L272.Text}" TextWrapping="Wrap"/>
                                </RadioButton>
                                <RadioButton x:Name="RbStartupFallback" Classes="option" IsCheckedChanged="StartupMode_Changed">
                                    <TextBlock Text="{DynamicResource L.GitSettingsView.L275.Text}" TextWrapping="Wrap"/>
                                </RadioButton>

                                <Border Classes="note">
                                    <TextBlock x:Name="TxtStartupHint" Classes="hint" MinHeight="16"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!--  高级 3：远端凭据 & 账号认证  -->
                        <Border x:Name="CredCard" Classes="subcard">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L.GitSettingsView.L287.Text}" Classes="subsection-title"/>
                                <TextBlock Classes="hint" Margin="0,4,0,10"
                                           Text="{DynamicResource L.GitSettingsView.L289.Text}"/>

                                <RadioButton x:Name="RbCredAuto" Classes="option" IsCheckedChanged="CredMode_Changed">
                                    <TextBlock Text="{DynamicResource L.GitSettingsView.L218.Text}" TextWrapping="Wrap"/>
                                </RadioButton>
                                <RadioButton x:Name="RbCredSystem" Classes="option" IsCheckedChanged="CredMode_Changed">
                                    <TextBlock Text="{DynamicResource L.GitSettingsView.L295.Text}" TextWrapping="Wrap"/>
                                </RadioButton>
                                <RadioButton x:Name="RbCredCustom" Classes="option" IsCheckedChanged="CredMode_Changed">
                                    <TextBlock Text="{DynamicResource L.GitSettingsView.L298.Text}" TextWrapping="Wrap"/>
                                </RadioButton>
                                <RadioButton x:Name="RbCredNone" Classes="option" IsCheckedChanged="CredMode_Changed">
                                    <TextBlock Text="{DynamicResource L.GitSettingsView.L301.Text}" TextWrapping="Wrap"/>
                                </RadioButton>

                                <Border Classes="note">
                                    <TextBlock Classes="hint"
                                               Text="{DynamicResource L.GitSettingsView.L306.Text}"/>
                                </Border>

                                <!-- 依赖区：仅「自动检测 / 只用自定义账号」需要自定义账号，其他模式整块灰度 -->
                                <StackPanel x:Name="CredEditPanel" Margin="0,14,0,0">
                                    <TextBlock Text="{DynamicResource L.GitSettingsView.L311.Text}" Classes="subsection-title"/>
                                    <TextBlock Classes="hint" Margin="0,4,0,6"
                                               Text="{DynamicResource L.GitSettingsView.L313.Text}"/>
                                    <ListBox x:Name="ListCred" Height="90" SelectionChanged="ListCred_SelectionChanged"/>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource L.GitSettingsView.L322.Text}" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CmbPlatform" Grid.Column="1" Margin="6,0,0,0" MinWidth="100"
                                                  SelectedIndex="3" SelectionChanged="CmbPlatform_SelectionChanged"
                                                  ToolTip.Tip="{DynamicResource L.GitSettingsView.L325.ToolTip_Tip}">
                                            <ComboBoxItem Content="Gitee（gitee.com）" Tag="gitee.com"/>
                                            <ComboBoxItem Content="GitHub（github.com）" Tag="github.com"/>
                                            <ComboBoxItem Content="{DynamicResource L.GitSettingsView.L328.Content}" Tag="cnb.cool"/>
                                            <ComboBoxItem Content="{DynamicResource L.GitSettingsView.L329.Content}" Tag=""/>
                                        </ComboBox>
                                        <Button x:Name="BtnPlatformToken" Grid.Column="2" Content="{DynamicResource L.GitSettingsView.L331.Content}"
                                                Padding="10,3" Margin="6,0,0,0" IsEnabled="False"
                                                Click="BtnPlatformToken_Click"
                                                ToolTip.Tip="{DynamicResource L.GitSettingsView.L334.ToolTip_Tip}"/>
                                    </Grid>

                                    <TextBlock x:Name="TxtPlatformHint" Classes="hint" Margin="0,6,0,0"/>

                                    <!-- 凭据输入：宽屏一行三个；窄屏由 ApplyResponsiveLayout 把令牌换到第二行 -->
                                    <Grid x:Name="CredInputGrid" Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBox x:Name="TxtCredHost" Grid.Column="0" VerticalContentAlignment="Center"
                                                 Watermark="{DynamicResource L.GitSettingsView.L351.Watermark}"
                                                 ToolTip.Tip="{DynamicResource L.GitSettingsView.L352.ToolTip_Tip}"/>
                                        <TextBox x:Name="TxtCredUser" Grid.Column="1" Margin="6,0,0,0" VerticalContentAlignment="Center"
                                                 Watermark="{DynamicResource L.GitSettingsView.L134.Text}" ToolTip.Tip="{DynamicResource L.GitSettingsView.L354.ToolTip_Tip}"/>
                                        <TextBox x:Name="TxtCredToken" Grid.Column="2" Margin="6,0,0,0" VerticalContentAlignment="Center"
                                                 Watermark="{DynamicResource L.GitSettingsView.L356.Watermark}" PasswordChar="*"
                                                 ToolTip.Tip="{DynamicResource L.GitSettingsView.L357.ToolTip_Tip}"/>
                                    </Grid>

                                    <WrapPanel Margin="0,8,0,0">
                                        <Button x:Name="BtnCredTest" Content="{DynamicResource L.GitSettingsView.L361.Content}" Padding="10,3" Click="BtnCredTest_Click"
                                                ToolTip.Tip="{DynamicResource L.GitSettingsView.L362.ToolTip_Tip}"/>
                                        <Button x:Name="BtnCredAdd" Content="{DynamicResource L.GitSettingsView.L363.Content}" Padding="10,3" Margin="6,0,0,0" Click="BtnCredAdd_Click"/>
                                        <Button x:Name="BtnCredDelete" Content="{DynamicResource L.GitSettingsView.L364.Content}" Padding="10,3" Margin="6,0,0,0" Click="BtnCredDelete_Click"/>
                                        <Button x:Name="BtnCredDetect" Content="{DynamicResource L.GitSettingsView.L365.Content}" Padding="10,3" Margin="6,0,0,0" Click="BtnCredDetect_Click"
                                                ToolTip.Tip="{DynamicResource L.GitSettingsView.L366.ToolTip_Tip}"/>
                                    </WrapPanel>

                                    <TextBlock Classes="hint" Margin="0,10,0,0"
                                               Text="{DynamicResource L.GitSettingsView.L370.Text}"/>
                                </StackPanel>

                                <!-- 账号操作结果放在依赖区之外，切换模式后的提示始终可见 -->
                                <Border Classes="log-box">
                                    <TextBlock x:Name="TxtCredResult" Classes="log" MinHeight="14"/>
                                </Border>

                                <TextBlock Text="{DynamicResource L.GitSettingsView.L378.Text}" Classes="subsection-title" Margin="0,14,0,0"/>
                                <TextBlock Classes="hint" Margin="0,4,0,6"
                                           Text="{DynamicResource L.GitSettingsView.L380.Text}"/>
                                <Border Classes="log-box" Margin="0,0,0,0">
                                    <TextBlock x:Name="TxtHelperInfo" Classes="log" MinHeight="14" TextWrapping="Wrap"
                                               ToolTip.Tip="{DynamicResource L.GitSettingsView.L383.ToolTip_Tip}"/>
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
